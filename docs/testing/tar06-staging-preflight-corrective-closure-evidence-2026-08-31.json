  "corrective_finding": {
    "severity": "fail_closed_contract_gap",
    "summary": "The TAR-06 staging harness called its input an approved preflight but previously proved only byte-level SHA-256 equality. Arbitrary bytes could therefore satisfy the approval-file digest without proving an APPROVED decision, a current approval window, an accountable owner, or authorization for the exact executable envelope.",
    "additional_gaps": [
      "The queue endpoint worker_ready flag did not prove a live dedicated terminal_agent worker before a queued load request.",
      "A caller could construct a field-equal command receipt and invoke the load port without consuming execute-time preflight state.",
      "Approval validity and worker heartbeat were not rechecked for every 1/5/10/20 staircase level, leaving a time-of-check/time-of-use window.",
      "A level that had already emitted partial traffic could be reauthorized after an uncontracted response, exceeding the approval's bounded request budget."
    ],
    "canonical_unit_added": false,
    "tar06_reopened_as_new_active_unit": false
  },

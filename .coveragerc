[run]
branch = true
source =
    apps
    core
    shared
    sdk/agomtradepro
    sdk/agomtradepro_mcp
parallel = true
omit =
    */migrations/*
    */tests/*
    */generated/*
    */vendor/*

[report]
precision = 1
show_missing = true
skip_covered = false
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    raise NotImplementedError
    if __name__ == .__main__.:

[xml]
output = coverage.xml

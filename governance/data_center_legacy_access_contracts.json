    "^apps/sector/models\\.py$",
    "^apps/sector/infrastructure/models\\.py$",
    "^apps/sector/migrations/",
    "^apps/sector/tests/",
    "^apps/fund/models\\.py$",
    "^apps/fund/infrastructure/models\\.py$",
    "^apps/fund/migrations/",
    "^apps/macro/(?:models\\.py|infrastructure/models\\.py)$",
    "^apps/macro/migrations/",
    "^apps/fund/tests/",
    "^apps/.+/tests/"
  ],
  "policy": {
    "new_business_reads": "blocked",
    "new_business_writes": "blocked",
    "legacy_admin_mutation": "blocked",
    "delete_after": "M9 observation window and verified backup"
  }

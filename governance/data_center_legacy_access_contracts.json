{
  "schema_version": "1.0",
  "owner": "data-center",
  "legacy_modules": {
    "apps.equity.infrastructure.models": [
      "StockInfoModel",
      "FinancialDataModel",
      "ValuationModel",
      "StockDailyModel"
    ],
    "apps.equity.models": [
      "StockInfoModel",
      "FinancialDataModel",
      "ValuationModel",
      "StockDailyModel"
    ],
    "apps.fund.infrastructure.models": [
      "FundNetValueModel"
    ],
    "apps.fund.models": [
      "FundNetValueModel"
    ],
    "apps.sector.infrastructure.models": [
      "SectorConstituentModel"
    ],
    "apps.sector.models": [
      "SectorConstituentModel"
    ],
    "apps.macro.infrastructure.models": [
      "MacroIndicator"
    ],
    "apps.macro.models": [
      "MacroIndicator"
    ]
  },
  "legacy_tables": [
    "equity_stock_info",

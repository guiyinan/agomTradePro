{
  "schema_version": "1.0",
  "owner": "data-center",
  "credential_owner": "apps.data_center.infrastructure.provider_credential_models.ProviderCredentialModel",
  "runtime_resolution_port": "apps.data_center.infrastructure.provider_state_repositories.ProviderConfigRepository",
  "entrypoints": [
    {
      "path": "apps/data_center/application/public.py",
      "symbol": "persist_provider_credentials",
      "role": "application_write_port"
    },
    {
      "path": "apps/data_center/infrastructure/provider_state_repositories.py",
      "symbol": "ProviderConfigRepository",
      "role": "runtime_resolution_and_write"
    },
    {
      "path": "apps/data_center/infrastructure/provider_credentials.py",
      "symbol": "ProviderCredentialStore",
      "role": "encryption_and_legacy_migration"
    },
    {
      "path": "apps/data_center/infrastructure/config_summary_repository.py",
      "symbol": "DjangoDataCenterConfigSummaryRepository",
      "role": "presence_only_projection"
    },
    {
      "path": "apps/data_center/interface/provider_api_views.py",
      "symbol": "provider_list_create",
      "role": "admin_api_input"
    },
    {
      "path": "apps/data_center/interface/admin.py",
      "symbol": "ProviderConfigAdmin",
      "role": "admin_input"
    },
    {
      "path": "apps/macro/interface/forms.py",
      "symbol": "DataSourceConfigForm",
      "role": "legacy_input_only_form"
    },
    {
      "path": "apps/setup_wizard/infrastructure/repositories.py",
      "symbol": "DataSourceRepository",
      "role": "setup_wizard_application_consumer"
    },
    {
      "path": "apps/macro/infrastructure/secrets_loader.py",
      "symbol": "load_secrets_from_database",
      "role": "legacy_secrets_projection_consumer"
    },
    {
      "path": "apps/data_center/infrastructure/tushare_client.py",
      "symbol": "create_tushare_pro_client",
      "role": "provider_runtime_consumer"
    },
    {
      "path": "apps/data_center/infrastructure/macro_sources/tushare_adapter.py",
      "symbol": "TushareAdapter",
      "role": "provider_runtime_consumer"
    }
  ],
  "legacy_plaintext_paths": [
    "^apps/data_center/migrations/",
    "^apps/data_center/models.py$",
    "^apps/data_center/infrastructure/models.py$",
    "^apps/data_center/interface/admin.py$",
    "^apps/data_center/infrastructure/provider_credentials.py$",
    "^apps/data_center/infrastructure/provider_state_repositories.py$",
    "^apps/data_center/infrastructure/config_summary_repository.py$",
    "^apps/data_center/infrastructure/diagnostic_queries.py$",
    "^apps/data_center/management/commands/encrypt_provider_credentials.py$"
  ],
  "policy": {
    "new_writes": "encrypted_provider_credential_owner_only",
    "runtime_reads": "ProviderConfigRepository_only",
    "legacy_columns": "read_only_until_explicit_migration_and_M9_cleanup",
    "responses": "masked_presence_and_credential_ref_only"
  }
}

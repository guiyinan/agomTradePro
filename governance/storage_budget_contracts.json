{
  "schema_version": "1.0",
  "owner": "config-center",
  "source_of_truth": "config_center_storage_budget_policy",
  "fail_closed_when_missing": true,
  "capacity_observation": {
    "model": "config_center_storage_capacity_observation",
    "command": "collect_storage_capacity_profile",
    "celery_task": "apps.config_center.application.tasks.collect_storage_capacity_profile_task",
    "schedule": "hourly",
    "application_public_port": "collect_and_record_storage_capacity_profile",
    "source": "read_only_filesystem_and_database_observer",
    "required_fields": [
      "filesystem_total_bytes",
      "filesystem_used_bytes",
      "filesystem_free_bytes",
      "database_size_bytes",
      "observed_at",
      "pressure_state"
    ]
  },
  "initialization_profiles": [
    {
      "profile_key": "production-90g",
      "environment": "production",
      "configured_capacity_gib": 90,
      "source": "database_initialization_projection",
      "must_be_explicitly_activated": true
    },
    {
      "profile_key": "development",
      "environment": "development",
      "configured_capacity_gib": null,
      "source": "database_initialization_projection",
      "must_be_explicitly_activated": true
    }
  ],
  "required_fields": [
    "configured_capacity_bytes",
    "raw_budget_ratio",
    "quarantine_budget_ratio",
    "database_budget_ratio",
    "logs_budget_ratio",
    "emergency_reserve_ratio",
    "warning_ratio",
    "critical_ratio",
    "active"
  ],
  "consumers": [
    "operational_readiness",
    "task_monitor",
    "data_center",
    "backup",
    "retention",
    "archive",
    "storage_hold"
  ]
}

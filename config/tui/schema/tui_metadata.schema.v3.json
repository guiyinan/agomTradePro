{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agomtradepro.local/schema/tui_metadata.schema.v3.json",
  "title": "AgomTradePro TUI Metadata Schema",
  "type": "object",
  "required": ["version", "default_screen", "groups", "modules", "screens", "actions"],
  "properties": {
    "schema_version": { "const": "tui-metadata.v3" },
    "version": { "type": "string", "minLength": 1 },
    "registry_key": { "type": "string" },
    "ia_version": { "type": "string", "minLength": 1 },
    "legacy_screen_aliases": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "default_screen": { "type": "string", "minLength": 1 },
    "interaction_model": { "type": "string" },
    "field_aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "principles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/group" }
    },
    "modules": {
      "type": "array",
      "items": { "$ref": "#/$defs/module" }
    },
    "screens": {
      "type": "array",
      "items": { "$ref": "#/$defs/screen" }
    },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    }
  },
  "$defs": {
    "group": {
      "type": "object",
      "required": ["key", "label"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "module": {
      "type": "object",
      "required": ["key", "label", "group", "summary"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "group": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "status": { "enum": ["online", "planned", "hidden", "disabled"] }
      },
      "additionalProperties": true
    },
    "screen": {
      "type": "object",
      "required": ["key", "label", "module_key", "group", "summary", "view_type", "audience"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "module_key": { "type": "string", "minLength": 1 },
        "group": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "view_type": { "$ref": "#/$defs/viewType" },
        "audience": { "enum": ["authenticated", "admin"] },
        "status": { "enum": ["online", "planned", "hidden", "disabled"] },
        "chrome_mode": { "enum": ["", "immersive"] },
        "default_action_key": { "type": "string" },
        "dashboard_layout": { "enum": ["adaptive_grid", "task_flow"] },
        "entry_mode": { "enum": ["auto_run", "parameter_gate", "dashboard"] },
        "entry_field_key": { "type": "string" },
        "dashboard_panels": {
          "type": "array",
          "items": { "$ref": "#/$defs/dashboardPanel" }
        },
        "user_experience": { "$ref": "#/$defs/userExperience" },
        "workflow": { "$ref": "#/$defs/workflow" },
        "business_context": { "type": "object" }
        ,"action_density": {
          "type": "object",
          "required": ["primary_operation_limit", "task_group_limit"],
          "properties": {
            "primary_operation_limit": { "type": "integer", "minimum": 1 },
            "task_group_limit": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "action": {
      "type": "object",
      "required": ["key", "label", "endpoint", "intent", "screen_key", "view_type"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "endpoint": { "type": "string", "pattern": "^/api/" },
        "intent": { "type": "string", "minLength": 1 },
        "screen_key": { "type": "string", "minLength": 1 },
        "module_key": { "type": "string" },
        "view_type": { "$ref": "#/$defs/viewType" },
        "risk": { "enum": ["read", "ai", "write", "unsafe", "admin"] },
        "audience": { "enum": ["authenticated", "admin"] },
        "effect": { "enum": ["read", "create", "update", "toggle", "delete", "execute"] },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        },
        "view_model": { "$ref": "#/$defs/viewModel" },
        "pagination": { "$ref": "#/$defs/pagination" },
        "description": { "type": "string" },
        "source": { "type": "string" },
        "raw_debug": { "type": "boolean" },
        "confirmation_required": { "type": "boolean" },
        "requires_password": { "type": "boolean" },
        "audit_required": { "type": "boolean" },
        "sensitive_level": { "enum": ["none", "low", "medium", "high", "critical"] },
        "executor": { "type": "string" },
        "task_group": { "type": "string" },
        "task_tier": { "enum": ["primary", "support", "advanced", "operation"] },
        "submit_label": { "type": "string", "minLength": 1 },
        "sequence": { "type": "integer" },
        "result_semantics": {
          "type": "array",
          "items": { "$ref": "#/$defs/presentationSemantic" }
        }
      },
      "additionalProperties": true
    },
    "field": {
      "type": "object",
      "required": ["key", "label"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "input_type": { "enum": ["text", "textarea", "number", "date", "checkbox", "select", "hidden", "file", "password"] },
        "value_type": { "enum": ["string", "integer", "float", "decimal", "boolean", "date", "datetime", "list", "object"] },
        "required": { "type": "boolean" },
        "default": {},
        "placeholder": { "type": "string" },
        "accept": { "type": "string" },
        "semantic": { "type": "string" },
        "presentation_semantic": {
          "enum": ["identifier", "primary_selector", "api_token", "endpoint_url", "prompt_text", "debug_only"]
        },
        "aliases": {
          "type": "array",
          "items": { "type": "string" }
        },
        "options": {
          "type": "array",
          "items": {
            "anyOf": [
              { "type": "string" },
              {
                "type": "object",
                "required": ["value", "label"],
                "properties": {
                  "value": { "type": ["string", "number", "boolean"] },
                  "label": { "type": "string" }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "binding": { "enum": ["path", "query", "body"] },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "unit": { "type": "string" }
      },
      "additionalProperties": false
    },
    "pagination": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["page", "offset", "cursor"] },
        "page_param": { "type": "string" },
        "page_size_param": { "type": "string" },
        "offset_param": { "type": "string" },
        "limit_param": { "type": "string" },
        "cursor_param": { "type": "string" },
        "next_cursor_path": { "type": "string" },
        "previous_cursor_path": { "type": "string" }
      },
      "additionalProperties": false
    },
    "viewModel": {
      "type": "object",
      "description": "Portable result projection contract. For kind=chart, rows_path selects tabular rows and columns defines the projection: the first column is the x-axis label and each remaining column is one numeric series. chart currently defaults to a line renderer; non-finite values are omitted and large row sets are deterministically sampled by the host projection.",
      "properties": {
        "kind": {
          "description": "Portable renderer kind. chart accepts the column projection convention; kpi_trend and table_chart require their documented result shapes.",
          "enum": ["auto", "datagrid", "detail", "message", "chart", "image", "kpi_trend", "table_chart", "host_slot", "custom"]
        },
        "chart_type": {
          "description": "Portable chart renderer. Omit for the backward-compatible line default.",
          "enum": ["line", "bar", "pie"]
        },
        "rows_path": {
          "type": "string",
          "description": "Dot path to the source row array. A conventional API envelope may be unwrapped before this path is evaluated."
        },
        "table_rows_path": {
          "type": "string",
          "description": "For table_chart, dot path to the tabular summary rows."
        },
        "chart_rows_path": {
          "type": "string",
          "description": "For table_chart, dot path to the chart source rows."
        },
        "total_path": { "type": "string" },
        "page_path": { "type": "string" },
        "page_size_path": { "type": "string" },
        "title_path": { "type": "string" },
        "status_path": { "type": "string" },
        "empty_message": {
          "type": "string",
          "minLength": 1,
          "description": "Task-specific user-facing message rendered when the projected result is empty."
        },
        "field_presentations": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/resultFieldPresentation" }
        },
        "columns": {
          "type": "array",
          "maxItems": 8,
          "description": "Ordered user-facing projection. For chart, the first item is the x-axis and the remaining items are numeric series; labels must include units when the unit is not otherwise unambiguous.",
          "items": {
            "type": "object",
            "required": ["key", "label"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "table_columns": {
          "type": "array",
          "maxItems": 8,
          "description": "For table_chart, ordered user-facing table columns.",
          "items": {
            "type": "object",
            "required": ["key", "label"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "chart_columns": {
          "type": "array",
          "maxItems": 8,
          "description": "For table_chart, x-axis followed by one or more numeric series.",
          "items": {
            "type": "object",
            "required": ["key", "label"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "dashboardPanel": {
      "type": "object",
      "required": ["key", "title", "kind"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["datagrid", "detail", "placeholder", "regime_quadrant", "status", "chart", "image", "kpi_trend", "table_chart", "host_slot", "custom"] },
        "action_key": { "type": "string" },
        "status": { "type": "string" },
        "note": { "type": "string" },
        "empty_message": { "type": "string" },
        "error_message": { "type": "string" },
        "stale_message": { "type": "string" },
        "max_rows": { "type": "integer" },
        "user_priority": { "enum": ["p0", "p1", "p2"] },
        "presentation_semantic": { "$ref": "#/$defs/presentationSemantic" },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "label"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "field_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "visible": { "type": "boolean" },
              "format": { "enum": ["text", "money", "percentage", "datetime"] }
            },
            "additionalProperties": false
          }
        },
        "row_actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/dashboardRowAction" }
        },
        "layout_area": { "type": "string" },
        "target_screen": { "type": "string" },
        "audience": { "enum": ["authenticated", "admin"] }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "lane": { "enum": ["decision", "governance"] },
        "step": { "type": "integer", "minimum": 1 },
        "total": { "type": "integer", "minimum": 1 },
        "label": { "type": "string" },
        "role": { "type": "string" },
        "previous": { "type": "object" },
        "next": { "type": "object" }
      },
      "additionalProperties": true
    },
    "dashboardRowAction": {
      "type": "object",
      "required": ["action_key", "label_template", "param_map"],
      "properties": {
        "action_key": { "type": "string", "minLength": 1 },
        "label_template": { "type": "string", "minLength": 1 },
        "param_map": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "result_panel_key": { "type": "string", "minLength": 1 },
        "refresh_panel_key": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "userExperience": {
      "type": "object",
      "required": ["journey", "primary_task", "primary_outcome", "empty_state_hint", "next_step_hint"],
      "properties": {
        "journey": { "enum": ["dashboard", "workspace", "self_service", "admin", "toolbox", "debug"] },
        "primary_task": { "type": "string", "minLength": 1 },
        "primary_outcome": { "type": "string", "minLength": 1 },
        "empty_state_hint": { "type": "string", "minLength": 1 },
        "next_step_hint": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "presentationSemantic": {
      "$comment": "primary_list and supporting_list cover owner-scoped alert and subscription collections; user_priority defines their visual order.",
      "enum": [
        "primary_status",
        "primary_list",
        "supporting_list",
        "copyable_secret",
        "endpoint_list",
        "multiline_prompt",
        "next_step",
        "supporting_detail",
        "debug_only"
      ]
    },
    "resultFieldPresentation": {
      "$comment": "Runtime result fields use explicit presentation values. Legacy fields without one render as metadata and never gain copy controls by inference.",
      "enum": ["secret", "copyable", "multiline", "metadata"]
    },
    "viewType": {
      "enum": ["auto", "status", "detail", "datagrid", "message", "queue_workbench", "chart", "image", "kpi_trend", "table_chart", "host_slot", "custom"]
    }
  },
  "additionalProperties": true
}

# Persistent server file: $TARGET_DIR/prometheus-query.env (root, mode 600).
# Production deploy validates it against the separate root-only
# $TARGET_DIR/prometheus-query-client.secret and stages a release/rollback copy.
# If only the client file exists, deploy derives bcrypt in VPS memory.
# Quote the hash with single quotes so Compose preserves literal dollar signs.
# Never place client plaintext passwords or actual hashes in Git or CLI arguments.
PROMETHEUS_QUERY_USER=monitoring
PROMETHEUS_QUERY_PASSWORD_HASH=''

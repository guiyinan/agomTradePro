# Core
# Leave empty to auto-generate on first boot (persisted in data volume).
# Or set explicitly:
#   SECRET_KEY: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#   AGOMTRADEPRO_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=
AGOMTRADEPRO_ENCRYPTION_KEY=
DEBUG=False
DJANGO_SETTINGS_MODULE=core.settings.production
ALLOWED_HOSTS=127.0.0.1,localhost,your-vps-ip

# CORS Configuration
# Leave origin allow-lists unset for same-origin deployment. Production settings
# will derive sane defaults from ALLOWED_HOSTS + SECURE_SSL_REDIRECT.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOW_CREDENTIALS=True

# Runtime image tags
WEB_IMAGE=agomtradepro-web:latest
REDIS_IMAGE=redis:7-alpine
POSTGRES_IMAGE=postgres:16-alpine
CADDY_IMAGE=caddy:2-alpine
RSSHUB_IMAGE=diygod/rsshub:latest

# PostgreSQL is mandatory in production. The deploy helper generates and
# persists POSTGRES_PASSWORD automatically when this value is left empty.
POSTGRES_DB=agomtradepro
POSTGRES_USER=agomtradepro
POSTGRES_PASSWORD=change-this-to-a-strong-postgres-password
DATABASE_URL=postgresql://agomtradepro:change-this-to-a-strong-postgres-password@postgres:5432/agomtradepro
REDIS_URL=redis://redis:6379/0
REDIS_MAXMEMORY=256mb
REALTIME_WEBSOCKET_ENABLED=True

# Internal SDK/MCP backend access used by terminal agent and MCP tools inside
# the Docker stack. Prefer Token auth in production; username/password should
# be reserved for short-lived troubleshooting or bootstrap flows.
AGOMTRADEPRO_BASE_URL=http://web:8000
# Canonical user-facing origin. The deploy helper derives this from DOMAIN.
APP_BASE_URL=
AGOMTRADEPRO_API_TOKEN=
AGOMTRADEPRO_USERNAME=
AGOMTRADEPRO_PASSWORD=
# Non-blocking MCP/SDK audit delivery: bounded timeout and idempotent retry.
AGOMTRADEPRO_AUDIT_TIMEOUT_SECONDS=5.0
AGOMTRADEPRO_AUDIT_MAX_ATTEMPTS=2
AGOMTRADEPRO_AUDIT_RETRY_BACKOFF_SECONDS=0.25

# Optional domain for Caddy. Set this for automatic HTTPS on 80/443.
DOMAIN=
# Host port mapping for Caddy. Use 80/443 for a normal public site.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Service toggles. Celery is enabled by default so /api/ready/ can verify
# background workers and scheduled jobs. Set ENABLE_CELERY=false only for
# an explicit low-memory maintenance mode.
ENABLE_RSSHUB=true
ENABLE_CELERY=true
AGOM_BACKUP_DIR=/opt/agomtradepro/backups/database
WEB_MEMORY_LIMIT=1g
CELERY_WORKER_MEMORY_LIMIT=2g
CELERY_WORKER_MAX_TASKS_PER_CHILD=1
CELERY_BEAT_MEMORY_LIMIT=512m
AGOMTRADEPRO_BOOTSTRAP_ON_START=1
AGOMTRADEPRO_BOOTSTRAP_ALPHA_ON_START=0
AGOMTRADEPRO_BOOTSTRAP_ALPHA_UNIVERSES=csi300
AGOMTRADEPRO_BOOTSTRAP_ALPHA_TOP_N=30
AGOMTRADEPRO_AUTO_MIGRATE_ON_START=1
MACRO_SYNC_HOUR=8
MACRO_SYNC_MINUTE=5

# Daphne serves both HTTP and Channels WebSockets.
DAPHNE_APPLICATION_CLOSE_TIMEOUT=10

# Security (HTTP/HTTPS)
# The deploy helper will turn these on automatically when DOMAIN is configured.
# For manual HTTP-only deployments, set them to False/0 before starting compose.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Optional superuser bootstrap
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Optional app keys
TUSHARE_TOKEN=
FRED_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=

+@pytest.mark.django_db
+def test_delete_rolls_back_all_three_rows_after_mid_mapping_failure(
+    alice: User,
+    portfolio_a: PortfolioModel,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """A mid-delete failure after map removal must roll back the whole operation."""
+
+    legacy, target = _create_closed_mapped_position_for_race(
+        portfolio_a,
+        asset_code="CLOSED_ROLLBACK_285",
+    )
+    assert legacy.pk is not None
+    assert target.pk is not None
+    legacy_id = legacy.id
+    target_id = int(target.pk)
+    repository = portfolio_api_services._portfolio_api_repo()
+    monkeypatch.setattr(portfolio_api_services, "_portfolio_api_repo", lambda: repository)
+    original_delete_mapping = repository.delete_position_mapping_for_target
+
+    def _delete_mapping_then_fail(position_id: int) -> None:
+        original_delete_mapping(position_id)
+        raise _InjectedLegacyDeleteFailure("injected after mapping delete")
+
+    monkeypatch.setattr(repository, "delete_position_mapping_for_target", _delete_mapping_then_fail)
+    before = _portfolio_atomic_business_snapshot()
+
+    with pytest.raises(_InjectedLegacyDeleteFailure):
+        portfolio_api_services.delete_position(
+            user_id=int(alice.pk),
+            position_id=target_id,
+        )
+
+    assert _portfolio_atomic_business_snapshot() == before
+    assert PositionModel._default_manager.filter(pk=legacy_id).exists()
+    assert SimPositionModel._default_manager.filter(pk=target_id).exists()
+    assert LedgerMigrationMapModel._default_manager.filter(
+        source_app="account",
+        source_table="position",
+        source_id=legacy_id,
+        target_table="simulated_position",
+        target_id=target_id,
+    ).exists()

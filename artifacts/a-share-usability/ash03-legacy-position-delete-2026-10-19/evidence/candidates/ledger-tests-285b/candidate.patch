+@pytest.mark.django_db
+def test_closed_mapped_lookup_without_race_returns_existing_target_unchanged(
+    alice: User,
+    portfolio_a: PortfolioModel,
+) -> None:
+    """A valid map remains an idempotent lookup and does not merge old shares."""
+
+    legacy, target = _create_closed_mapped_position_for_race(
+        portfolio_a,
+        asset_code="CLOSED_CONTROL_285",
+    )
+    assert legacy.pk is not None
+    assert target.pk is not None
+    before = _portfolio_atomic_business_snapshot()
+
+    _context, payload = portfolio_api_services.get_position_payload(
+        user_id=int(alice.pk),
+        position_id=legacy.id,
+    )
+
+    assert payload["id"] == target.pk
+    assert payload["shares"] == pytest.approx(float(target.quantity))
+    target.refresh_from_db()
+    assert target.quantity == Decimal("25")
+    assert _portfolio_atomic_business_snapshot() == before
+

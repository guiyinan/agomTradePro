+@pytest.mark.django_db
+def test_closed_source_read_does_not_resurrect_after_delete_before_parent_lock(
+    alice: User,
+    alice_client: APIClient,
+    portfolio_a: PortfolioModel,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """A cached closed-source row must not be recreated after a real delete."""
+
+    asset_code = "CLOSED_RACE_285"
+    legacy, target = _create_closed_mapped_position_for_race(
+        portfolio_a,
+        asset_code=asset_code,
+    )
+    assert legacy.pk is not None
+    assert target.pk is not None
+    legacy_id = legacy.id
+    target_id = int(target.pk)
+    owner_id = int(alice.pk)
+
+    repository = portfolio_api_services._portfolio_api_repo()
+    monkeypatch.setattr(portfolio_api_services, "_portfolio_api_repo", lambda: repository)
+    original_parent_transaction = cast(
+        Callable[..., AbstractContextManager[None]],
+        repository.legacy_sync_transaction,
+    )
+    delete_invoked: list[bool] = []
+    state_after_delete: list[tuple[tuple[dict[str, object], ...], ...]] = []
+
+    def _delete_before_parent_transaction(
+        **kwargs: object,
+    ) -> AbstractContextManager[None]:
+        """Run caller B once before opening A's original parent scope."""
+
+        if not delete_invoked:
+            delete_invoked.append(True)
+            portfolio_api_services.delete_position(
+                user_id=owner_id,
+                position_id=target_id,
+            )
+            assert not PositionModel._default_manager.filter(pk=legacy_id).exists()
+            assert not SimPositionModel._default_manager.filter(pk=target_id).exists()
+            assert not LedgerMigrationMapModel._default_manager.filter(
+                source_app="account",
+                source_table="position",
+                source_id=legacy_id,
+            ).exists()
+            state_after_delete.append(_portfolio_atomic_business_snapshot())
+        return original_parent_transaction(**kwargs)
+
+    monkeypatch.setattr(
+        repository,
+        "legacy_sync_transaction",
+        _delete_before_parent_transaction,
+    )
+
+    response = alice_client.get(f"/api/account/positions/{legacy_id}/")
+
+    assert delete_invoked == [True]
+    assert len(state_after_delete) == 1
+    assert not PositionModel._default_manager.filter(pk=legacy_id).exists()
+    assert not SimPositionModel._default_manager.filter(
+        account_id=target.account_id,
+        asset_code=asset_code,
+    ).exists()
+    assert not LedgerMigrationMapModel._default_manager.filter(
+        source_app="account",
+        source_table="position",
+        source_id=legacy_id,
+    ).exists()
+    assert _portfolio_atomic_business_snapshot() == state_after_delete[0]
+    assert response.status_code in (404, 409), response.data
+    if response.status_code == 409:
+        assert response.data.get("code") == "LEGACY_POSITION_RECONCILIATION_REQUIRED"
+

"""
Ledger unification acceptance tests.

Verifies the rework requirements:
1. Migration of 2 portfolios for the same user → 2 independent real accounts (no merging).
2. Non-integer position migration preserves quantity/cost/pnl precision.
3. PATCH with is_closed is silently ignored (field not in serializer).
4. /api/account/positions/* itself is the canonical real-account ledger path.
5. Migration command is idempotent (no duplicate accounts/positions/trades on re-run).
6. close creates a SimulatedTradeModel sell record; partial close leaves correct remainder.
"""

from collections.abc import Callable
from contextlib import AbstractContextManager
from datetime import date
from decimal import Decimal
from typing import cast

import pytest
from django.contrib.auth.models import User
from django.core.management import CommandError, call_command
from rest_framework.test import APIClient

from apps.account.application import portfolio_api_services
from apps.account.infrastructure.models import (
    PortfolioModel,
    PositionModel,
)
from apps.simulated_trading.infrastructure import models as simulated_ledger_models
from apps.simulated_trading.infrastructure.models import (
    LedgerMigrationMapModel,
    SimulatedAccountModel,
    SimulatedTradeModel,
)

SimPositionModel = simulated_ledger_models.PositionModel

# ── helper fixtures ───────────────────────────────────────────────────────────


@pytest.fixture
def alice(db):
    return User.objects.create_user(username="alice_ledger", password="x")


@pytest.fixture
def alice_client(alice):
    c = APIClient()
    c.force_authenticate(alice)
    return c


@pytest.fixture
def portfolio_a(alice):
    return PortfolioModel.objects.create(user=alice, name="Portfolio-A", is_active=True)


@pytest.fixture
def portfolio_b(alice):
    return PortfolioModel.objects.create(user=alice, name="Portfolio-B", is_active=True)


def _mk_position(portfolio, asset_code="600000.SH", shares=1000.0, avg_cost="10.00", price="12.00"):
    return PositionModel.objects.create(
        portfolio=portfolio,
        asset_code=asset_code,
        asset_class="equity",
        region="CN",
        cross_border="domestic",
        shares=shares,
        avg_cost=Decimal(avg_cost),
        current_price=Decimal(price),
        market_value=Decimal(str(shares * float(price))),
        unrealized_pnl=Decimal(str(shares * (float(price) - float(avg_cost)))),
        unrealized_pnl_pct=float((float(price) - float(avg_cost)) / float(avg_cost) * 100),
        source="manual",
        is_closed=False,
    )


# ── 1. Migration: two portfolios → two independent real accounts ──────────────


@pytest.mark.django_db
@pytest.mark.parametrize("user_id", [0, -1, True, "invalid"])
def test_migration_rejects_invalid_user_scope(user_id) -> None:
    """Invalid user filters must never fall through to an all-user migration."""

    with pytest.raises(CommandError, match="user_id 必须是正整数"):
        call_command("migrate_account_ledger", user_id=user_id, dry_run=True)


@pytest.mark.django_db
def test_migration_two_portfolios_create_two_independent_accounts(alice, portfolio_a, portfolio_b):
    """
    Running migrate_account_ledger for a user with 2 portfolios must produce
    2 independent LedgerMigrationMap entries pointing to different real accounts.
    """
    import unittest.mock as mock

    with mock.patch("builtins.input", return_value="yes"):
        from django.core.management import call_command

        call_command("migrate_account_ledger", f"--user-id={alice.id}")

    # Verify 1-to-1 mapping entries exist for BOTH portfolios
    map_a = LedgerMigrationMapModel.objects.get(
        source_app="account", source_table="portfolio", source_id=portfolio_a.id
    )
    map_b = LedgerMigrationMapModel.objects.get(
        source_app="account", source_table="portfolio", source_id=portfolio_b.id
    )
    assert (
        map_a.target_id != map_b.target_id
    ), "Two portfolios must not map to the same real account"

    # Confirm the two mapped accounts are distinct real accounts
    acct_a = SimulatedAccountModel.objects.get(id=map_a.target_id)
    acct_b = SimulatedAccountModel.objects.get(id=map_b.target_id)
    assert acct_a.account_type == "real"
    assert acct_b.account_type == "real"
    assert acct_a.account_name == "Portfolio-A"
    assert acct_b.account_name == "Portfolio-B"


# ── 2. Non-integer position migration preserves precision ─────────────────────


@pytest.mark.django_db
def test_migration_non_integer_shares_preserved(alice, portfolio_a):
    """
    Fractional shares (e.g., 10.5) must survive migration without int(round(...)).
    """
    import unittest.mock as mock

    _mk_position(portfolio_a, asset_code="000001.SZ", shares=10.5, avg_cost="20.00", price="22.00")

    with mock.patch("builtins.input", return_value="yes"):
        from django.core.management import call_command

        call_command("migrate_account_ledger", f"--user-id={alice.id}")

    sim_pos = SimPositionModel.objects.filter(asset_code="000001.SZ").first()
    assert sim_pos is not None, "Migrated position not found"
    assert (
        abs(float(sim_pos.quantity) - 10.5) < 1e-4
    ), f"Expected quantity ~10.5, got {sim_pos.quantity}"


# ── 3. PATCH is_closed is ignored ────────────────────────────────────────────


@pytest.mark.django_db
def test_patch_is_closed_has_no_effect(alice_client, portfolio_a):
    """
    Sending is_closed=true via PATCH must not close the position.
    Close must only happen through the /close/ endpoint.
    """
    pos = _mk_position(portfolio_a)

    resp = alice_client.patch(
        f"/api/account/positions/{pos.id}/",
        {"shares": 1000, "avg_cost": "10.00", "current_price": "12.00", "is_closed": True},
        format="json",
    )
    assert resp.status_code in (200, 400)  # 200 = ignored; 400 = rejected

    pos.refresh_from_db()
    assert pos.is_closed is False, "PATCH must not close the position via is_closed field"


# ── 4. account positions API is the canonical unified ledger path ─────────────


@pytest.mark.django_db
def test_account_api_create_visible_in_account_positions(alice_client, portfolio_a):
    """
    A position created via POST /api/account/positions/ must be stored in the
    unified ledger, and /api/account/positions/ remains the only canonical
    real-account holdings endpoint.
    """
    resp = alice_client.post(
        "/api/account/positions/",
        {
            "portfolio": portfolio_a.id,
            "asset_code": "UNIFIED_TEST",
            "asset_class": "equity",
            "region": "CN",
            "cross_border": "domestic",
            "shares": 500,
            "avg_cost": "8.00",
            "current_price": "9.00",
            "source": "manual",
        },
        format="json",
    )
    assert resp.status_code == 201, resp.data
    created_id = resp.data["id"]

    # Verify entry exists in simulated_trading (unified ledger)
    sim_pos = SimPositionModel.objects.filter(asset_code="UNIFIED_TEST").first()
    assert sim_pos is not None, "Position must be written to the unified ledger"
    assert abs(float(sim_pos.quantity) - 500) < 1e-4
    assert created_id == sim_pos.id
    buy_trades = SimulatedTradeModel.objects.filter(
        account=sim_pos.account,
        asset_code="UNIFIED_TEST",
        action="buy",
    )
    assert buy_trades.count() == 1
    assert float(buy_trades.get().quantity) == pytest.approx(500.0)

    increase_resp = alice_client.post(
        "/api/account/positions/",
        {
            "portfolio": portfolio_a.id,
            "asset_code": "UNIFIED_TEST",
            "asset_class": "equity",
            "region": "CN",
            "cross_border": "domestic",
            "shares": 50,
            "avg_cost": "10.00",
            "current_price": "10.00",
            "source": "manual",
        },
        format="json",
    )
    assert increase_resp.status_code == 201, increase_resp.data
    assert increase_resp.data["id"] == created_id

    sim_pos.refresh_from_db()
    assert float(sim_pos.quantity) == pytest.approx(550.0)
    assert float(sim_pos.avg_cost) == pytest.approx((500 * 8 + 50 * 10) / 550, abs=1e-4)
    assert buy_trades.count() == 2

    list_resp = alice_client.get(
        "/api/account/positions/", {"portfolio_id": portfolio_a.id}, format="json"
    )
    assert list_resp.status_code == 200
    list_payload = list_resp.json()
    rows = list_payload.get("results", list_payload)
    assert any(row["id"] == sim_pos.id for row in rows)


# ── 5. Migration idempotency ──────────────────────────────────────────────────


@pytest.mark.django_db
def test_migration_idempotent(alice, portfolio_a):
    """
    Running migrate_account_ledger twice must not create duplicate accounts,
    positions, or trades.
    """
    import unittest.mock as mock

    _mk_position(portfolio_a)

    def _run():
        with mock.patch("builtins.input", return_value="yes"):
            from django.core.management import call_command

            call_command("migrate_account_ledger", f"--user-id={alice.id}")

    _run()
    accounts_after_first = SimulatedAccountModel.objects.filter(
        user=alice, account_type="real"
    ).count()
    positions_after_first = SimPositionModel.objects.count()

    _run()
    assert (
        SimulatedAccountModel.objects.filter(user=alice, account_type="real").count()
        == accounts_after_first
    ), "Second migration run must not create duplicate accounts"

    assert (
        SimPositionModel.objects.count() == positions_after_first
    ), "Second migration run must not create duplicate positions"


# ── helpers for API-created positions (so the ledger mapping is recorded) ──────


def _api_create_position(
    client, portfolio, asset_code="LEDGER_TEST", shares=200, avg_cost="10.00", price="12.00"
):
    resp = client.post(
        "/api/account/positions/",
        {
            "portfolio": portfolio.id,
            "asset_code": asset_code,
            "asset_class": "equity",
            "region": "CN",
            "cross_border": "domestic",
            "shares": shares,
            "avg_cost": avg_cost,
            "current_price": price,
            "source": "manual",
        },
        format="json",
    )
    assert resp.status_code == 201, resp.data
    # PositionCreateSerializer does not expose id; query by portfolio + asset_code
    return (
        PositionModel.objects.filter(portfolio=portfolio, asset_code=asset_code)
        .order_by("-id")
        .first()
    )


# ── 6. close creates sell trade; partial close leaves correct remainder ────────


@pytest.mark.django_db
def test_close_via_unified_service_creates_sell_trade(alice_client, portfolio_a):
    """
    POST /api/account/positions/{id}/close/ must write a SimulatedTradeModel
    sell record in the unified ledger when the position was created via API.
    """
    pos = _api_create_position(alice_client, portfolio_a, asset_code="CLOSE_FULL", shares=200)

    resp = alice_client.post(f"/api/account/positions/{pos.id}/close/", {}, format="json")
    assert resp.status_code == 200, resp.data

    sell_trades = SimulatedTradeModel.objects.filter(asset_code="CLOSE_FULL", action="sell")
    assert sell_trades.exists(), "Unified ledger must contain a sell trade after close"


@pytest.mark.django_db
def test_partial_close_leaves_correct_remainder(alice_client, portfolio_a):
    """
    Partial close of 300 shares out of 1000 must:
    - Leave 700 in apps/account mirror.
    - Write a sell trade for 300 in the unified ledger.
    """
    pos = _api_create_position(alice_client, portfolio_a, asset_code="CLOSE_PARTIAL", shares=1000)

    resp = alice_client.post(
        f"/api/account/positions/{pos.id}/close/", {"shares": 300}, format="json"
    )
    assert resp.status_code == 200, resp.data

    pos.refresh_from_db()
    assert float(pos.shares) == pytest.approx(700.0, abs=0.01)

    sell_trade = SimulatedTradeModel.objects.filter(
        asset_code="CLOSE_PARTIAL", action="sell"
    ).first()
    assert sell_trade is not None
    assert abs(float(sell_trade.quantity) - 300) < 1e-4


@pytest.mark.django_db
def test_legacy_portfolio_read_keeps_total_and_reports_available_unknown(alice, portfolio_a):
    """A legacy-only holding keeps its total without inventing a simulated BUY."""

    legacy = _mk_position(
        portfolio_a,
        asset_code="LEGACY_READ_UNKNOWN",
        shares=300,
        avg_cost="10.00",
        price="12.00",
    )
    assert not SimPositionModel._default_manager.filter(pk=legacy.id).exists()

    client = APIClient()
    client.force_authenticate(alice)
    url = f"/api/account/portfolios/{portfolio_a.id}/positions/"
    first = client.get(url)
    assert first.status_code == 200, first.data
    assert first["Content-Type"].split(";", 1)[0] == "application/json"
    assert first.data["count"] == 1
    second = client.get(url)
    assert second.status_code == 200, second.data
    assert second["Content-Type"].split(";", 1)[0] == "application/json"
    assert second.data["count"] == 1

    account_mapping = LedgerMigrationMapModel._default_manager.get(
        source_app="account",
        source_table="portfolio",
        source_id=portfolio_a.id,
    )
    sim_position = SimPositionModel._default_manager.get(
        account_id=account_mapping.target_id,
        asset_code=legacy.asset_code,
    )
    legacy_mapping_count = LedgerMigrationMapModel._default_manager.filter(
        source_app="account",
        source_table="position",
        source_id=legacy.id,
        target_table="simulated_position",
        target_id=sim_position.id,
    ).count()
    trade_count = SimulatedTradeModel._default_manager.filter(
        account_id=account_mapping.target_id,
        asset_code=legacy.asset_code,
    ).count()
    row = second.data["data"][0]
    available_value = row.get("available_quantity")
    assert row.get("first_buy_date") is None
    assert row.get("first_buy_date_known") is False

    assert (
        Decimal(str(sim_position.quantity)),
        float(row["shares"]),
        available_value,
        row.get("available_quantity_status"),
        getattr(sim_position, "available_quantity_known", None),
        SimPositionModel._default_manager.filter(
            account_id=account_mapping.target_id,
            asset_code=legacy.asset_code,
        ).count(),
        legacy_mapping_count,
        trade_count,
    ) == (
        Decimal("300"),
        300.0,
        None,
        "unknown",
        False,
        1,
        1,
        0,
    )


@pytest.mark.django_db
def test_legacy_position_detail_read_has_same_unknown_availability(alice, portfolio_a):
    """Legacy-id detail lookup uses the same non-trading bootstrap contract."""

    legacy = _mk_position(
        portfolio_a,
        asset_code="600009.SH",
        shares=300,
        avg_cost="10.00",
        price="12.00",
    )
    assert not SimPositionModel._default_manager.filter(pk=legacy.id).exists()

    client = APIClient()
    client.force_authenticate(alice)
    url = f"/api/account/positions/{legacy.id}/"
    first = client.get(url)
    assert first.status_code == 200, first.data
    assert first["Content-Type"].split(";", 1)[0] == "application/json"
    second = client.get(url)
    assert second.status_code == 200, second.data
    assert second["Content-Type"].split(";", 1)[0] == "application/json"

    account_mapping = LedgerMigrationMapModel._default_manager.get(
        source_app="account",
        source_table="portfolio",
        source_id=portfolio_a.id,
    )
    sim_position = SimPositionModel._default_manager.get(
        account_id=account_mapping.target_id,
        asset_code=legacy.asset_code,
    )
    legacy_mapping_count = LedgerMigrationMapModel._default_manager.filter(
        source_app="account",
        source_table="position",
        source_id=legacy.id,
        target_table="simulated_position",
        target_id=sim_position.id,
    ).count()
    trade_count = SimulatedTradeModel._default_manager.filter(
        account_id=account_mapping.target_id,
        asset_code=legacy.asset_code,
    ).count()
    row = second.data
    assert row.get("first_buy_date") is None
    assert row.get("first_buy_date_known") is False

    assert (
        Decimal(str(sim_position.quantity)),
        float(row["shares"]),
        row.get("available_quantity"),
        row.get("available_quantity_status"),
        getattr(sim_position, "available_quantity_known", None),
        SimPositionModel._default_manager.filter(
            account_id=account_mapping.target_id,
            asset_code=legacy.asset_code,
        ).count(),
        legacy_mapping_count,
        trade_count,
    ) == (
        Decimal("300"),
        300.0,
        None,
        "unknown",
        False,
        1,
        1,
        0,
    )


# ── 7. Legacy bootstrap rejects ambiguous or corrupt ledger relationships ────


def _create_mapped_real_account(portfolio):
    """Create the unified real account already selected for this portfolio."""

    account = SimulatedAccountModel._default_manager.create(
        user=portfolio.user,
        account_name=f"{portfolio.name} legacy conflict fixture",
        account_type="real",
        initial_capital=Decimal("0.00"),
        current_cash=Decimal("0.00"),
        total_value=Decimal("0.00"),
        auto_trading_enabled=False,
    )
    LedgerMigrationMapModel._default_manager.create(
        source_app="account",
        source_table="portfolio",
        source_id=portfolio.id,
        target_table="simulated_account",
        target_id=account.id,
    )
    return account


def _create_unified_position(account, asset_code, quantity=Decimal("75")):
    """Create an existing unified row for a ledger-conflict fixture."""

    return SimPositionModel._default_manager.create(
        account=account,
        asset_code=asset_code,
        asset_name=asset_code,
        asset_type="equity",
        quantity=quantity,
        available_quantity=quantity,
        avg_cost=Decimal("10.00"),
        total_cost=quantity * Decimal("10.00"),
        current_price=Decimal("10.00"),
        market_value=quantity * Decimal("10.00"),
        first_buy_date=date(2026, 1, 1),
    )


def _ledger_side_effect_snapshot() -> tuple[tuple[dict[str, object], ...], ...]:
    """Capture every stored ledger field, including knowledge flags and costs."""
    return tuple(
        tuple(model._default_manager.order_by("pk").values())
        for model in (SimPositionModel, LedgerMigrationMapModel, SimulatedTradeModel)
    )


def _assert_legacy_reconciliation_conflict(response):
    """Assert the stable JSON conflict contract for unsafe legacy adoption."""

    assert response.status_code == 409, response.data
    assert response["Content-Type"].split(";", 1)[0] == "application/json"
    assert response.data.get("code") == "LEGACY_POSITION_RECONCILIATION_REQUIRED"


@pytest.mark.django_db
def test_duplicate_legacy_assets_conflict_without_unified_writes(alice, portfolio_a):
    """Two legacy rows for one asset must not bootstrap a partial unified ledger."""

    account = _create_mapped_real_account(portfolio_a)
    _mk_position(portfolio_a, asset_code="DUP_LEGACY_01", shares=100)
    _mk_position(portfolio_a, asset_code="DUP_LEGACY_01", shares=200)
    before = _ledger_side_effect_snapshot()

    client = APIClient()
    client.force_authenticate(alice)
    response = client.get(f"/api/account/portfolios/{portfolio_a.id}/positions/")

    _assert_legacy_reconciliation_conflict(response)
    assert _ledger_side_effect_snapshot() == before
    assert not SimPositionModel._default_manager.filter(account=account).exists()


@pytest.mark.django_db
def test_unmapped_unified_asset_conflicts_without_merging_legacy_quantity(alice, portfolio_a):
    """An existing same-account asset without a source map must never be added to."""

    account = _create_mapped_real_account(portfolio_a)
    legacy = _mk_position(
        portfolio_a,
        asset_code="UNMAPPED_TARGET",
        shares=300,
        avg_cost="10.00",
        price="12.00",
    )
    target = _create_unified_position(
        account,
        legacy.asset_code,
        quantity=Decimal("75"),
    )
    assert not LedgerMigrationMapModel._default_manager.filter(
        source_app="account",
        source_table="position",
        source_id=legacy.id,
    ).exists()
    before = _ledger_side_effect_snapshot()

    client = APIClient()
    client.force_authenticate(alice)
    response = client.get(f"/api/account/portfolios/{portfolio_a.id}/positions/")

    _assert_legacy_reconciliation_conflict(response)
    assert _ledger_side_effect_snapshot() == before
    target.refresh_from_db()
    assert target.quantity == Decimal("75")


@pytest.mark.django_db
@pytest.mark.parametrize(
    "mapping_problem",
    ["wrong_target_table", "wrong_account", "wrong_asset", "dangling_target"],
)
def test_invalid_legacy_source_mapping_conflicts_without_changes(
    alice, portfolio_a, mapping_problem
):
    """A source map must target the exact unified position in the selected account."""

    account = _create_mapped_real_account(portfolio_a)
    legacy = _mk_position(
        portfolio_a,
        asset_code="600009.SH",
        shares=300,
        avg_cost="10.00",
        price="12.00",
    )
    if mapping_problem == "wrong_target_table":
        target = _create_unified_position(account, legacy.asset_code)
        target_table = "simulated_trade"
        target_id = target.id
    elif mapping_problem == "wrong_account":
        foreign_account = SimulatedAccountModel._default_manager.create(
            user=alice,
            account_name="Unrelated legacy conflict fixture",
            account_type="real",
            initial_capital=Decimal("0.00"),
            current_cash=Decimal("0.00"),
            total_value=Decimal("0.00"),
            auto_trading_enabled=False,
        )
        target = _create_unified_position(foreign_account, legacy.asset_code)
        target_table = "simulated_position"
        target_id = target.id
    elif mapping_problem == "wrong_asset":
        target = _create_unified_position(account, "600010.SH")
        target_table = "simulated_position"
        target_id = target.id
    else:
        assert mapping_problem == "dangling_target"
        target_table = "simulated_position"
        target_id = -1
        assert not SimPositionModel._default_manager.filter(pk=target_id).exists()

    LedgerMigrationMapModel._default_manager.create(
        source_app="account",
        source_table="position",
        source_id=legacy.id,
        target_table=target_table,
        target_id=target_id,
    )
    before = _ledger_side_effect_snapshot()

    client = APIClient()
    client.force_authenticate(alice)
    response = client.get(f"/api/account/portfolios/{portfolio_a.id}/positions/")

    _assert_legacy_reconciliation_conflict(response)
    assert _ledger_side_effect_snapshot() == before


def _portfolio_atomic_business_snapshot() -> tuple[tuple[dict[str, object], ...], ...]:
    """Capture complete source and unified portfolio, position, map, trade, and account rows."""

    return tuple(
        tuple(model._default_manager.order_by("pk").values())
        for model in (
            PortfolioModel,
            PositionModel,
            SimPositionModel,
            LedgerMigrationMapModel,
            SimulatedTradeModel,
            SimulatedAccountModel,
        )
    )


@pytest.mark.django_db
def test_later_legacy_mapping_conflict_leaves_full_portfolio_ledger_unchanged(
    alice: User,
    portfolio_a: PortfolioModel,
) -> None:
    """A late source-map conflict must roll back an earlier valid legacy adoption."""

    account = _create_mapped_real_account(portfolio_a)
    first_legacy = _mk_position(
        portfolio_a,
        asset_code="ATOMIC_FIRST_01",
        shares=100,
        avg_cost="10.00",
        price="12.00",
    )
    conflicting_legacy = _mk_position(
        portfolio_a,
        asset_code="ATOMIC_LATER_02",
        shares=200,
        avg_cost="11.00",
        price="13.00",
    )
    assert first_legacy.id < conflicting_legacy.id
    assert not LedgerMigrationMapModel._default_manager.filter(
        source_app="account",
        source_table="position",
        source_id=first_legacy.id,
    ).exists()
    assert not SimPositionModel._default_manager.filter(
        account=account,
        asset_code=first_legacy.asset_code,
    ).exists()

    conflicting_target = _create_unified_position(account, conflicting_legacy.asset_code)
    LedgerMigrationMapModel._default_manager.create(
        source_app="account",
        source_table="position",
        source_id=conflicting_legacy.id,
        target_table="simulated_trade",
        target_id=conflicting_target.id,
    )
    before = _portfolio_atomic_business_snapshot()

    client = APIClient()
    client.force_authenticate(alice)
    response = client.get(f"/api/account/portfolios/{portfolio_a.id}/positions/")

    _assert_legacy_reconciliation_conflict(response)
    assert _portfolio_atomic_business_snapshot() == before


@pytest.mark.django_db
@pytest.mark.parametrize(
    "mapping_problem",
    ("dangling", "wrong_table", "wrong_owner", "wrong_account_type"),
)
def test_invalid_existing_portfolio_mapping_conflicts_without_repair(
    alice: User,
    portfolio_a: PortfolioModel,
    mapping_problem: str,
) -> None:
    """Reject a dangling or inconsistent portfolio map without touching ledger rows."""

    target_table = "simulated_account"
    if mapping_problem == "dangling":
        target_id = -1
    else:
        account_owner: User = alice
        account_type = "real"
        if mapping_problem == "wrong_table":
            target_table = "simulated_position"
        elif mapping_problem == "wrong_owner":
            account_owner = User.objects.create_user(
                username="wrong_portfolio_map_owner",
                password="unused",
            )
        elif mapping_problem == "wrong_account_type":
            account_type = "simulated"
        else:
            pytest.fail(f"Unexpected mapping problem: {mapping_problem}")

        account = SimulatedAccountModel._default_manager.create(
            user=account_owner,
            account_name=f"invalid portfolio map {mapping_problem}",
            account_type=account_type,
            initial_capital=Decimal("1000.00"),
            current_cash=Decimal("1000.00"),
            current_market_value=Decimal("0.00"),
            total_value=Decimal("1000.00"),
            auto_trading_enabled=False,
        )
        target_id = account.id

    LedgerMigrationMapModel._default_manager.create(
        source_app="account",
        source_table="portfolio",
        source_id=portfolio_a.id,
        target_table=target_table,
        target_id=target_id,
    )
    before = _portfolio_atomic_business_snapshot()

    client = APIClient()
    client.force_authenticate(alice)
    response = client.get(f"/api/account/portfolios/{portfolio_a.id}/positions/")

    _assert_legacy_reconciliation_conflict(response)
    assert _portfolio_atomic_business_snapshot() == before


@pytest.mark.django_db
def test_duplicate_reverse_source_maps_conflict_without_changes(
    alice: User,
    portfolio_a: PortfolioModel,
) -> None:
    """Reject two source maps that both claim the same unified position."""

    account = _create_mapped_real_account(portfolio_a)
    open_legacy = _mk_position(
        portfolio_a,
        asset_code="600011.SH",
        shares=100,
        avg_cost="10.00",
        price="12.00",
    )
    unified_position = _create_unified_position(
        account,
        open_legacy.asset_code,
        quantity=Decimal("100"),
    )
    LedgerMigrationMapModel._default_manager.create(
        source_app="account",
        source_table="position",
        source_id=open_legacy.id,
        target_table="simulated_position",
        target_id=unified_position.id,
    )

    closed_legacy = _mk_position(
        portfolio_a,
        asset_code=open_legacy.asset_code,
        shares=0,
        avg_cost="10.00",
        price="12.00",
    )
    closed_legacy.is_closed = True
    closed_legacy.save(update_fields=["is_closed"])
    LedgerMigrationMapModel._default_manager.create(
        source_app="account",
        source_table="position",
        source_id=closed_legacy.id,
        target_table="simulated_position",
        target_id=unified_position.id,
    )
    assert (
        LedgerMigrationMapModel._default_manager.filter(
            source_app="account",
            source_table="position",
            target_table="simulated_position",
            target_id=unified_position.id,
        ).count()
        == 2
    )
    before = _portfolio_atomic_business_snapshot()

    client = APIClient()
    client.force_authenticate(alice)
    response = client.get(f"/api/account/portfolios/{portfolio_a.id}/positions/")

    _assert_legacy_reconciliation_conflict(response)
    assert _portfolio_atomic_business_snapshot() == before


# ── 8. Closed legacy source delete interleavings ───────────────────────────────


class _InjectedLegacyDeleteFailure(RuntimeError):
    """Inject one failure after the mapping delete in the test."""


def _create_closed_mapped_position_for_race(
    portfolio: PortfolioModel,
    *,
    asset_code: str,
) -> tuple[PositionModel, simulated_ledger_models.PositionModel]:
    """Create one closed legacy source and an exact, distinct unified target."""

    account = _create_mapped_real_account(portfolio)
    legacy = _mk_position(
        portfolio,
        asset_code=asset_code,
        shares=100,
        avg_cost="10.00",
        price="12.00",
    )
    legacy.is_closed = True
    legacy.closed_at = legacy.opened_at
    legacy.save(update_fields=["is_closed", "closed_at"])

    reservation = _create_unified_position(account, f"RACE_SLOT_{legacy.pk}")
    reservation.delete()
    target = _create_unified_position(
        account,
        asset_code,
        quantity=Decimal("25"),
    )
    if target.pk == legacy.pk:
        target.delete()
        target = _create_unified_position(
            account,
            asset_code,
            quantity=Decimal("25"),
        )

    assert legacy.pk is not None
    assert target.pk is not None
    legacy_id = int(legacy.pk)
    target_id = int(target.pk)
    assert target_id != legacy_id
    assert not SimPositionModel._default_manager.filter(pk=legacy_id).exists()
    LedgerMigrationMapModel._default_manager.create(
        source_app="account",
        source_table="position",
        source_id=legacy_id,
        target_table="simulated_position",
        target_id=target_id,
    )
    return legacy, target


@pytest.mark.django_db
def test_closed_source_read_does_not_resurrect_after_delete_before_parent_lock(
    alice: User,
    alice_client: APIClient,
    portfolio_a: PortfolioModel,
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    """A cached closed-source row must not be recreated after a real delete."""

    asset_code = "CLOSED_RACE_285"
    legacy, target = _create_closed_mapped_position_for_race(
        portfolio_a,
        asset_code=asset_code,
    )
    assert legacy.pk is not None
    assert target.pk is not None
    legacy_id = legacy.id
    target_id = int(target.pk)
    owner_id = int(alice.pk)

    repository = portfolio_api_services._portfolio_api_repo()
    monkeypatch.setattr(portfolio_api_services, "_portfolio_api_repo", lambda: repository)
    original_parent_transaction = cast(
        Callable[..., AbstractContextManager[None]],
        repository.legacy_sync_transaction,
    )
    delete_invoked: list[bool] = []
    state_after_delete: list[tuple[tuple[dict[str, object], ...], ...]] = []

    def _delete_before_parent_transaction(
        **kwargs: object,
    ) -> AbstractContextManager[None]:
        """Run caller B once before opening A's original parent scope."""

        if not delete_invoked:
            delete_invoked.append(True)
            portfolio_api_services.delete_position(
                user_id=owner_id,
                position_id=target_id,
            )
            assert not PositionModel._default_manager.filter(pk=legacy_id).exists()
            assert not SimPositionModel._default_manager.filter(pk=target_id).exists()
            assert not LedgerMigrationMapModel._default_manager.filter(
                source_app="account",
                source_table="position",
                source_id=legacy_id,
            ).exists()
            state_after_delete.append(_portfolio_atomic_business_snapshot())
        return original_parent_transaction(**kwargs)

    monkeypatch.setattr(
        repository,
        "legacy_sync_transaction",
        _delete_before_parent_transaction,
    )

    response = alice_client.get(f"/api/account/positions/{legacy_id}/")

    assert delete_invoked == [True]
    assert len(state_after_delete) == 1
    assert not PositionModel._default_manager.filter(pk=legacy_id).exists()
    assert not SimPositionModel._default_manager.filter(
        account_id=target.account_id,
        asset_code=asset_code,
    ).exists()
    assert not LedgerMigrationMapModel._default_manager.filter(
        source_app="account",
        source_table="position",
        source_id=legacy_id,
    ).exists()
    assert _portfolio_atomic_business_snapshot() == state_after_delete[0]
    assert response.status_code in (404, 409), response.data
    if response.status_code == 409:
        assert response.data.get("code") == "LEGACY_POSITION_RECONCILIATION_REQUIRED"


@pytest.mark.django_db
def test_closed_mapped_lookup_without_race_returns_existing_target_unchanged(
    alice: User,
    portfolio_a: PortfolioModel,
) -> None:
    """A valid map remains an idempotent lookup and does not merge old shares."""

    legacy, target = _create_closed_mapped_position_for_race(
        portfolio_a,
        asset_code="CLOSED_CONTROL_285",
    )
    assert legacy.pk is not None
    assert target.pk is not None
    before = _portfolio_atomic_business_snapshot()

    _context, payload = portfolio_api_services.get_position_payload(
        user_id=int(alice.pk),
        position_id=legacy.id,
    )

    assert payload["id"] == target.pk
    assert payload["shares"] == pytest.approx(float(target.quantity))
    target.refresh_from_db()
    assert target.quantity == Decimal("25")
    assert _portfolio_atomic_business_snapshot() == before


@pytest.mark.django_db
def test_delete_rolls_back_all_three_rows_after_mid_mapping_failure(
    alice: User,
    portfolio_a: PortfolioModel,
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    """A mid-delete failure after map removal must roll back the whole operation."""

    legacy, target = _create_closed_mapped_position_for_race(
        portfolio_a,
        asset_code="CLOSED_ROLLBACK_285",
    )
    assert legacy.pk is not None
    assert target.pk is not None
    legacy_id = legacy.id
    target_id = int(target.pk)
    repository = portfolio_api_services._portfolio_api_repo()
    monkeypatch.setattr(portfolio_api_services, "_portfolio_api_repo", lambda: repository)
    original_delete_mapping = repository.delete_position_mapping_for_target

    def _delete_mapping_then_fail(position_id: int) -> None:
        original_delete_mapping(position_id)
        raise _InjectedLegacyDeleteFailure("injected after mapping delete")

    monkeypatch.setattr(repository, "delete_position_mapping_for_target", _delete_mapping_then_fail)
    before = _portfolio_atomic_business_snapshot()

    with pytest.raises(_InjectedLegacyDeleteFailure):
        portfolio_api_services.delete_position(
            user_id=int(alice.pk),
            position_id=target_id,
        )

    assert _portfolio_atomic_business_snapshot() == before
    assert PositionModel._default_manager.filter(pk=legacy_id).exists()
    assert SimPositionModel._default_manager.filter(pk=target_id).exists()
    assert LedgerMigrationMapModel._default_manager.filter(
        source_app="account",
        source_table="position",
        source_id=legacy_id,
        target_table="simulated_position",
        target_id=target_id,
    ).exists()

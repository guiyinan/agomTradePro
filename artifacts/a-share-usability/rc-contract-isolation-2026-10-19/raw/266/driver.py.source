from ash_delivery_common_229 import *
import tarfile

d=ROOT/'.tmp/ash-rc-export-266';d.mkdir();guard()
base='2a9b1f6e656c1b1e6c261fd41288b1a73069315d';assert git('rev-parse','HEAD')==base
export=Path(r'C:\Users\muku\AppData\Local\Temp\ash-rc-2a9-dfvx24j7')
assert export.is_dir() and export.parent==Path(os.environ['LOCALAPPDATA'])/'Temp'
archive=d/'source.tar'
with archive.open('xb') as out:subprocess.run(['git','-c','core.autocrlf=false','-c','core.eol=lf','archive','--format=tar',base],cwd=ROOT,stdout=out,check=True)
with tarfile.open(archive) as source:source.extractall(export,filter='data')
paths=['tests/api/test_manual_trade_current_reference.py','tests/migrations/conftest.py','apps/equity/application/research_snapshot.py','apps/data_center/application/query_services.py']
for p in paths:assert (export/p).read_bytes()==subprocess.check_output(['git','show',base+':'+p],cwd=ROOT)
receipt={'base':base,'export':str(export),'pure_git_archive':True,'core_autocrlf':False,'core_eol':'lf','archive_sha256':sha(archive),'files':[{'path':p,'sha256':sha(export/p)} for p in paths],'ash04_uncommitted_excluded':True,'prior_attempt':'263 stopped before QA: default Windows archive text conversion produced CRLF; original archive preserved. 264 also used platform-native EOL and stopped before QA. 266 explicitly sets core.eol=lf and matches Git blobs.'}
(d/'export.json').write_text(json.dumps(receipt,indent=2)+'\n');guard();print(json.dumps(receipt))

from ash_delivery_common_229 import *

d=ROOT/'.tmp/ash-rc-delivery-gates-273';d.mkdir();guard()
owned=json.loads((ROOT/'.tmp/ash_rc_owned_272.json').read_text());export=Path(json.loads((ROOT/'.tmp/ash-rc-export-266/export.json').read_text())['export'])
for p in owned:
 dest=export/p;dest.parent.mkdir(parents=True,exist_ok=True);dest.write_bytes((ROOT/p).read_bytes())
frozen=[{'path':p,'sha256':sha(ROOT/p)} for p in owned];(d/'inputs.json').write_text(json.dumps({'base':git('rev-parse','HEAD'),'export':str(export),'owned':frozen,'ash04_excluded':True},indent=2)+'\n')
for tag,c in [('current_data',PY+['scripts/check_current_data_contracts.py']),('plans',PY+['scripts/check_active_plan_registry.py']),('governance',PY+['scripts/check_governance_consistency.py'])]:
 run(d,tag,c,cwd=export);assert all(sha(ROOT/r['path'])==r['sha256'] and sha(export/r['path'])==r['sha256'] for r in frozen)
print(json.dumps({'all_passed':True,'owned_unchanged':True,'ash04_excluded':True}))

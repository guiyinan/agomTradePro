"""Capture test-only fixture checks against a Git-bound, protected working tree."""
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
import time

root = Path(__file__).resolve().parent.parent
os.chdir(root)
directory = Path('.tmp/ash03-auto-caller-136')
directory.mkdir(exist_ok=True)
base = '0e54384678e6b0bbddc72e4fb1088455d1c34b52'
owned = ['tests/component/simulated_trading/test_auto_trading_engine_t1_caller.py',
         'tests/component/simulated_trading/test_auto_trading_sell_rollback.py']
protected = json.loads(Path('.tmp/ash03-sell-126/green.inputs.json').read_text(encoding='utf-8'))['protected']
def digest(path):
 return hashlib.sha256(Path(path).read_bytes()).hexdigest()
def freeze():
 assert subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip() == base
 assert not subprocess.check_output(['git','diff','--cached','--name-only'],text=True).strip()
 dirty = set(subprocess.check_output(['git','diff','--name-only'],text=True).splitlines())
 assert dirty <= set(owned)|set(protected), dirty
 others = set(subprocess.check_output(['git','ls-files','--others','--exclude-standard'],text=True).splitlines())
 assert others <= set(owned)|set(protected), others
 for path,value in protected.items():
  assert digest(path) == value, path
 assert 'flags: 20004000' in subprocess.check_output(['git','ls-files','--debug','--','tests/unit/simulated_trading/test_ash01_settlement_regressions.py'],text=True)
 return {'base_head':base,'base_tree':subprocess.check_output(['git','rev-parse','HEAD^{tree}'],text=True).strip(),
  'owned_files':[{'path':path,'raw_sha256':digest(path)} for path in owned],
  'protected_files':[{'path':path,'raw_sha256':value} for path,value in protected.items()],
  'tracked_dirty_paths':sorted(dirty),'untracked_paths':sorted(others),
  'source_contract':'All tracked files match base tree except declared owned tests and protected WIP; no undeclared nonignored untracked files',
  'window':'TUX explicit full handback at 1a5728c07d11c8647a812a97209353a011366782; TUX read-only until next handback'}
tag = sys.argv[1]
before = freeze()
command = json.loads((directory/(tag+'.command.json')).read_text(encoding='utf-8'))
snapshot = directory/(tag+'.inputs.json')
assert not snapshot.exists()
snapshot.write_text(json.dumps(before,indent=2)+'\n',encoding='utf-8')
log = directory/(tag+'.log')
start = time.monotonic()
with log.open('xb') as stream:
 result = subprocess.run(command,env=dict(os.environ,PYTHONUTF8='1',PYTHONIOENCODING='utf-8',PYTEST_ADDOPTS='',DJANGO_SETTINGS_MODULE='core.settings.development_sqlite'),stdout=stream,stderr=subprocess.STDOUT,check=False)
assert freeze() == before, 'source state changed during check'
record = {'tag':tag,'command':command,'exit_code':result.returncode,'seconds':round(time.monotonic()-start,3),
 'inputs':snapshot.as_posix(),'inputs_sha256':digest(snapshot),'log':log.as_posix(),'log_sha256':digest(log),
 'driver_raw_sha256':digest(__file__),'source_unchanged':True}
(directory/(tag+'.result.json')).write_text(json.dumps(record,indent=2)+'\n',encoding='utf-8')
print(json.dumps(record))
raise SystemExit(result.returncode)

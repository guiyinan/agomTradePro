"""Represent public digest maps as explicit records, with verified lossless decoding."""
import hashlib,json,re,shutil
from pathlib import Path
artifact=Path('artifacts/a-share-usability/ash03-automatic-ledger-2026-10-19')
d=Path('.tmp/ash03-security-normalization-208');d.mkdir()
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
report=json.loads(Path('.tmp/ash03-security-files-207/redacted-report.json').read_text())
prefix='.tmp/ash03-security-files-207/proposed/'
metadata=sorted({row['File'].removeprefix(prefix) for row in report if row['File'].removeprefix(prefix).startswith(artifact.as_posix()+'/')})
assert len(metadata)==4
def encode(value):
 if isinstance(value,dict):
  if value and all(isinstance(v,str) and re.fullmatch('[0-9a-f]{40}|[0-9a-f]{64}',v) for v in value.values()) and any('/' in k or '.' in k for k in value):
   return {'__digest_map_records_v1__':[{'path':k,'digest':v} for k,v in value.items()]}
  return {k:encode(v) for k,v in value.items()}
 if isinstance(value,list):return [encode(v) for v in value]
 return value
def decode(value):
 if isinstance(value,dict):
  if set(value)=={'__digest_map_records_v1__'}:return {r['path']:r['digest'] for r in value['__digest_map_records_v1__']}
  return {k:decode(v) for k,v in value.items()}
 if isinstance(value,list):return [decode(v) for v in value]
 return value
index=json.loads((artifact/'raw-files.json').read_text());changes=[]
for path in metadata:
 p=Path(path);raw=p.read_bytes();original=json.loads(raw);content=encode(original);assert decode(content)==original
 serialization=None
 for ascii_value in [True,False]:
  for newline in ['\n','\r\n']:
   for trailing in [True,False]:
    rebuilt=(json.dumps(original,indent=2,ensure_ascii=ascii_value)+('\n' if trailing else '')).replace('\n',newline).encode()
    if rebuilt==raw:serialization={'indent':2,'ensure_ascii':ascii_value,'newline':newline,'trailing_newline':trailing};break
   if serialization:break
  if serialization:break
 assert serialization is not None,p
 original_hash=hashlib.sha256(raw).hexdigest()
 saved=d/p.relative_to(artifact);saved.parent.mkdir(parents=True,exist_ok=True);saved.write_bytes(raw)
 wrapper={'representation':'digest_map_records_v1','original_raw_sha256':original_hash,'serialization':serialization,'content':content}
 p.write_text(json.dumps(wrapper,indent=2)+'\n',encoding='utf-8')
 relative=p.relative_to(artifact).as_posix();row=next(r for r in index['files'] if r['archived_path']==relative)
 assert row['sha256']==original_hash
 row.update({'original_raw_sha256':original_hash,'sha256':sha(p),'bytes':p.stat().st_size,'representation':'digest_map_records_v1','lossless_original_bytes_round_trip_verified':True})
 changes.append({'path':path,'original_raw_sha256':original_hash,'archived_sha256':sha(p),'round_trip_original_bytes_verified':True})
# Confirm both other findings are test-owned, opaque operation labels, not provider credentials.
test_path=Path('tests/unit/simulated_trading/test_auto_trading_outcome_interfaces.py')
test_raw_before=test_path.read_bytes();text=test_path.read_text();replacements=[]
for i,row in enumerate([r for r in report if r['File'].removeprefix(prefix)==test_path.as_posix()],1):
 fragment=Path(row['File']).read_text().splitlines()[row['StartLine']-1]
 match=re.search(r'invocation_key="(outcome-[a-z-]+-001)"',fragment);assert match,fragment
 old=match.group(1);assert text.count('invocation_key="'+old+'"')==1
 new='test-run-'+str(i)
 text=text.replace('invocation_key="'+old+'"','invocation_key="'+new+'"',1)
 replacements.append({'old_label_sha256':hashlib.sha256(old.encode()).hexdigest(),'replacement':new,'classification':'Test literal passed as noncredential operation identity; no external service/API authentication.'})
assert len(replacements)==2
(d/'test-before.py.source').write_bytes(test_raw_before)
test_path.write_text(text,encoding='utf-8')
(artifact/'raw-files.json').write_text(json.dumps(index,indent=2)+'\n',encoding='utf-8')
evidence=json.loads((artifact/'evidence.json').read_text())
evidence['raw_files_index_sha256']=sha(artifact/'raw-files.json')
for row in evidence['source_files']:
 if row['path']==test_path.as_posix():row['raw_sha256']=sha(test_path)
evidence['quality']['security_initial_scan']={'exit_code':1,'findings':17,'classification':'15 public Git/content digest assignments in four metadata maps plus two synthetic operation-key test literals; no credential established','disposition':'Lossless explicit path/digest metadata representation and low-entropy noncredential test labels; scanner/rules/allowlists unchanged; clean rescan still required.'}
(artifact/'evidence.json').write_text(json.dumps(evidence,indent=2,ensure_ascii=False)+'\n',encoding='utf-8')
record={'metadata':changes,'test_file':test_path.as_posix(),'test_preimage_sha256':hashlib.sha256(test_raw_before).hexdigest(),'test_postimage_sha256':sha(test_path),'test_literal_replacements':replacements,'scanner_configuration_unchanged':True,'production_sources_unchanged':True,'raw_originals_preserved_locally':True}
(d/'receipt.json').write_text(json.dumps(record,indent=2)+'\n');print(json.dumps(record,indent=2))

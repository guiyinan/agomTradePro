"""Losslessly decode the four public digest-map metadata wrappers."""
import hashlib, json
from pathlib import Path

def decode(value):
    if isinstance(value, dict):
        if set(value) == {"__digest_map_records_v1__"}:
            return {row["path"]: row["digest"] for row in value["__digest_map_records_v1__"]}
        return {key: decode(item) for key, item in value.items()}
    if isinstance(value, list):
        return [decode(item) for item in value]
    return value

def original_bytes(path):
    wrapper = json.loads(Path(path).read_text(encoding="utf-8"))
    assert wrapper["representation"] == "digest_map_records_v1"
    settings = wrapper["serialization"]
    text = json.dumps(decode(wrapper["content"]), indent=settings["indent"], ensure_ascii=settings["ensure_ascii"])
    if settings["trailing_newline"]:
        text += "\n"
    raw = text.replace("\n", settings["newline"]).encode("utf-8")
    assert hashlib.sha256(raw).hexdigest() == wrapper["original_raw_sha256"]
    return raw

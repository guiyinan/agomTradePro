"""Regenerate the actual schema declarations and admit only their bounded closure."""
import hashlib,json,os,shutil,subprocess,time
from pathlib import Path
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
old=Path('.tmp/ash03-openapi-bounded-185');packet=Path('.tmp/ash03-openapi-bounded-200')
d=Path('.tmp/ash03-openapi-final-200');packet.mkdir();d.mkdir()
inputs=json.loads((old/'inputs.json').read_text())
before={'views_sha256':sha('apps/simulated_trading/interface/views.py'),'declarations_only':True}
(d/'source.inputs.json').write_text(json.dumps(before,indent=2)+'\n')
generated={}
for tag in ['root_yaml','api_yaml','api_json']:
 c=json.loads(Path('.tmp/ash03-auto-openapi-183',tag+'.command.json').read_text())
 target=c[-1]; exported=(d/'full_exports'/target).resolve(); exported.parent.mkdir(parents=True,exist_ok=True); c[-1]=str(exported); generated[target]=exported
 (d/(tag+'.command.json')).write_text(json.dumps(c)+'\n')
 t=time.monotonic()
 with (d/(tag+'.log')).open('xb') as log:r=subprocess.run(c,env=dict(os.environ,PYTHONUTF8='1',PYTEST_ADDOPTS='',DJANGO_SETTINGS_MODULE='core.settings.development_sqlite'),stdout=log,stderr=subprocess.STDOUT)
 record={'command':c,'exit_code':r.returncode,'seconds':round(time.monotonic()-t,3),'log_sha256':sha(d/(tag+'.log')),'output_path':c[-1],'output_sha256':sha(c[-1]) if r.returncode==0 else None}
 (d/(tag+'.result.json')).write_text(json.dumps(record,indent=2)+'\n')
 assert r.returncode==0,tag
 assert sha('apps/simulated_trading/interface/views.py')==before['views_sha256']
for row in inputs['paths']:
 p=row['target'];base=packet/'base'/p;full=packet/'full_generated'/p
 base.parent.mkdir(parents=True,exist_ok=True);full.parent.mkdir(parents=True,exist_ok=True)
 baseline=subprocess.check_output(['git','show',inputs['base']+':'+p])
 assert hashlib.sha256(baseline).hexdigest()==row['base_sha256']
 base.write_bytes(baseline);shutil.copyfile(generated[p],full)
 row['full_generated_sha256']=sha(full)
(packet/'inputs.json').write_text(json.dumps(inputs,indent=2)+'\n')
shutil.copyfile(old/'build_bounded_projection.py',packet/'build_bounded_projection.py')
assert sha(packet/'build_bounded_projection.py')=='469453654c1f6f2e94c992628c07b1821be6f6ae896400145dfb468a51c08f15'
c=['D:/githv/agomTradePro/agomtradepro/Scripts/python.exe','-X','utf8',str(packet/'build_bounded_projection.py')]
with (d/'projection.log').open('xb') as log:r=subprocess.run(c,stdout=log,stderr=subprocess.STDOUT)
assert r.returncode==0
files=[]
for row in inputs['paths']:
 p=packet/'candidate'/row['target'];files.append({'target':row['target'],'candidate_path':p.as_posix(),'sha256':sha(p),'bytes':p.stat().st_size})
for row in files:Path(row['target']).write_bytes(Path(row['candidate_path']).read_bytes())
receipt={'base':inputs['base'],'files':files,'builder_sha256':sha(packet/'build_bounded_projection.py'),'all_projection_assertions_passed':True,'source':before,'scope':'One endpoint plus original seven-schema closure; other baseline semantics unchanged; no full-schema freshness claim.'}
(packet/'manifest.json').write_text(json.dumps(receipt,indent=2)+'\n');(d/'projection.result.json').write_text(json.dumps(receipt,indent=2)+'\n');print(json.dumps(receipt))

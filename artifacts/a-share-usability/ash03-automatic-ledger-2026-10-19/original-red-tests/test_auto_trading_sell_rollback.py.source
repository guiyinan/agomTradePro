"""Verify one failed automatic SELL leaves its persisted ledger unchanged.

The engine and repositories are real. Only market/exit inputs are fixed locally,
and one target account ORM write is failed at Django's actual ``save_base``
boundary. This is a per-trade atomicity contract; it does not make a multi-account
run one transaction.
"""

from __future__ import annotations

from collections.abc import Callable
from datetime import UTC, date, datetime
from decimal import Decimal
from types import SimpleNamespace
from typing import cast
from unittest.mock import Mock

import pytest
from django.contrib.auth import get_user_model
from django.db import DatabaseError, models
from django.db.models import Model
from django.utils import timezone as django_timezone
from pytest import MonkeyPatch

from apps.simulated_trading.application import facade as simulated_trading_facade
from apps.simulated_trading.application import interface_services
from apps.simulated_trading.application.auto_trading_engine import AutoTradingEngine
from apps.simulated_trading.application.ports import PositionExitAdvice
from apps.simulated_trading.domain.entities import Position
from apps.simulated_trading.infrastructure.models import (
    FeeConfigModel,
    PositionModel,
    SimulatedAccountModel,
    SimulatedTradeModel,
)
from apps.simulated_trading.infrastructure.repositories import (
    DjangoFeeConfigRepository,
    DjangoPositionRepository,
    DjangoSimulatedAccountRepository,
    DjangoTradeRepository,
)
from apps.strategy.application import execution_gateway
from apps.strategy.application.execution_gateway import ExecutionResult, SignalInfo

pytestmark = pytest.mark.django_db

_ASSET_CODE = "600000.SH"
_EXECUTION_NOW = datetime(2026, 10, 19, 2, 0, tzinfo=UTC)
_EXECUTION_DATE = _EXECUTION_NOW.date()


class _ServerUTCClock:
    """Hold the server clock at one explicit aware UTC instant for this test."""

    def now(self) -> datetime:
        """Return the fixed settlement-compatible instant."""
        return _EXECUTION_NOW


@pytest.fixture(autouse=True)
def freeze_server_clock(monkeypatch: MonkeyPatch) -> None:
    """Freeze Django timestamps before the persisted ledger fixture is created."""
    clock = _ServerUTCClock()
    monkeypatch.setattr(django_timezone, "now", clock.now)


class _FixedPriceProvider:
    """Supply one deterministic branch-triggering price without market I/O."""

    def get_price(self, asset_code: str, trade_date: date) -> float:
        """Return the fixed local test price."""
        assert asset_code == _ASSET_CODE
        assert trade_date == _EXECUTION_DATE
        return 11.0

    def require_price(self, asset_code: str, trade_date: date) -> float:
        """Return the same fixed price if the engine requests a fallback."""
        return self.get_price(asset_code, trade_date)


class _AlwaysSellAdvisor:
    """Provide one explicit legacy exit advice for the test position."""

    def get_exit_advices(
        self,
        account_id: int,
        positions: list[object],
        as_of_date: date,
    ) -> list[PositionExitAdvice]:
        """Return a full-exit advice for the configured test security."""
        assert account_id > 0
        assert as_of_date == _EXECUTION_DATE
        assert any(
            isinstance(position, Position) and position.asset_code == _ASSET_CODE
            for position in positions
        )
        return [
            PositionExitAdvice(
                asset_code=_ASSET_CODE,
                should_exit=True,
                reason_code="LOCAL_SELL_ATOMICITY_TEST",
                reason_text="local database failure test",
                source="tests.component.simulated_trading",
            )
        ]


def _performance_update_succeeded(account_id: int, trade_date: date) -> bool:
    """Keep post-trade performance I/O outside this ledger rollback contract."""
    assert account_id > 0
    assert trade_date == _EXECUTION_DATE
    return True


@pytest.fixture
def persisted_sell_ledger(monkeypatch: MonkeyPatch) -> tuple[SimulatedAccountModel, PositionModel]:
    """Create a real simulated account and one fully sellable position."""
    monkeypatch.setenv("AGOMTRADEPRO_DISABLE_USER_PROVISIONING_SIGNALS", "1")
    owner = get_user_model().objects.create_user(username="ash-sell-atomicity-owner")
    FeeConfigModel.objects.filter(asset_type="equity", is_default=True).update(is_default=False)
    FeeConfigModel.objects.create(
        config_name="ash-sell-atomicity-explicit-equity-fee",
        asset_type="equity",
        min_commission=5.0,
        commission_rate_buy=0.0003,
        commission_rate_sell=0.0003,
        stamp_duty_rate=0.0005,
        transfer_fee_rate=0.0,
        slippage_rate=0.0,
        is_default=True,
        is_active=True,
    )
    account = SimulatedAccountModel.objects.create(
        user=owner,
        account_name="ash-sell-atomicity-account",
        account_type="simulated",
        initial_capital=Decimal("100000.00"),
        current_cash=Decimal("100000.00"),
        current_market_value=Decimal("11000.00"),
        total_value=Decimal("111000.00"),
        total_trades=0,
        winning_trades=0,
        auto_trading_enabled=True,
        is_active=True,
    )
    position = PositionModel.objects.create(
        account=account,
        asset_code=_ASSET_CODE,
        asset_name="浦发银行",
        asset_type="equity",
        quantity=Decimal("1000.000000"),
        available_quantity=Decimal("1000.000000"),
        available_quantity_known=True,
        avg_cost=Decimal("10.0000"),
        total_cost=Decimal("10000.00"),
        cost_basis_known=True,
        current_price=Decimal("11.0000"),
        market_value=Decimal("11000.00"),
        valuation_known=True,
        unrealized_pnl=Decimal("1000.00"),
        unrealized_pnl_pct=10.0,
        first_buy_date=date(2026, 10, 16),
        first_buy_date_known=True,
    )
    return account, position


def _build_real_engine(monkeypatch: MonkeyPatch) -> AutoTradingEngine:
    """Call the production builder with actual Django ledger repositories."""
    account_repo = DjangoSimulatedAccountRepository()
    position_repo = DjangoPositionRepository()
    trade_repo = DjangoTradeRepository()
    fee_config_repo = DjangoFeeConfigRepository()
    pool_repo = Mock()
    pool_repo.list_investable_assets.return_value = []
    signal_repo = Mock()

    monkeypatch.setattr(
        interface_services,
        "get_simulated_account_repository",
        lambda: account_repo,
    )
    monkeypatch.setattr(
        interface_services,
        "get_simulated_position_repository",
        lambda: position_repo,
    )
    monkeypatch.setattr(
        interface_services,
        "get_simulated_trade_repository",
        lambda: trade_repo,
    )
    monkeypatch.setattr(
        interface_services,
        "get_simulated_fee_config_repository",
        lambda: fee_config_repo,
    )
    monkeypatch.setattr(interface_services, "get_signal_repository", lambda: signal_repo)
    monkeypatch.setattr(interface_services, "get_asset_pool_query_repository", lambda: pool_repo)
    monkeypatch.setattr(
        interface_services,
        "build_decision_rhythm_exit_advisor",
        lambda: _AlwaysSellAdvisor(),
    )
    engine = interface_services.build_auto_trading_engine()
    engine.price_provider = _FixedPriceProvider()
    engine.execution_link_recorder = None
    engine._update_account_performance = _performance_update_succeeded
    return engine


@pytest.mark.parametrize("caller", ["legacy", "strategy"])
def test_automatic_sell_account_write_failure_rolls_back_trade_and_position(
    monkeypatch: MonkeyPatch,
    persisted_sell_ledger: tuple[SimulatedAccountModel, PositionModel],
    caller: str,
) -> None:
    """A target account-row write failure must roll back the whole SELL ledger."""
    account, position = persisted_sell_ledger
    engine = _build_real_engine(monkeypatch)

    strategy_id = 91 if caller == "strategy" else None
    monkeypatch.setattr(
        simulated_trading_facade,
        "get_simulated_trading_facade",
        lambda: SimpleNamespace(
            get_active_strategy_id=lambda account_id: strategy_id,
        ),
    )
    if caller == "strategy":
        gateway = Mock()
        gateway.execute_for_account.return_value = ExecutionResult(
            success=True,
            signals=[
                SignalInfo(
                    signal_id=None,
                    asset_code=_ASSET_CODE,
                    asset_name="浦发银行",
                    action="sell",
                    quantity=1000,
                    confidence=1.0,
                    reason="local atomicity test",
                )
            ],
        )
        monkeypatch.setattr(execution_gateway, "get_strategy_execution_gateway", lambda: gateway)

    attempted_account_writes: list[int] = []
    original_save_base = cast(Callable[..., None], models.Model.save_base)

    def fail_only_target_account_write(
        instance: Model,
        *args: object,
        **kwargs: object,
    ) -> None:
        if isinstance(instance, SimulatedAccountModel) and instance.pk == account.pk:
            attempted_account_writes.append(account.pk)
            raise DatabaseError("injected account ledger write failure")
        original_save_base(instance, *args, **kwargs)

    monkeypatch.setattr(Model, "save_base", fail_only_target_account_write)

    outcome = engine.run_daily_trading(_EXECUTION_DATE, [account.pk])[account.pk]

    assert attempted_account_writes == [account.pk]
    assert outcome.sell_count == 0
    assert not SimulatedTradeModel.objects.filter(
        account_id=account.pk,
        asset_code=_ASSET_CODE,
        action="sell",
    ).exists()

    persisted_position = PositionModel.objects.get(pk=position.pk)
    assert persisted_position.quantity == position.quantity
    assert persisted_position.available_quantity == position.available_quantity
    assert persisted_position.total_cost == position.total_cost
    assert persisted_position.market_value == position.market_value

    account.refresh_from_db()
    assert account.current_cash == Decimal("100000.00")
    assert account.current_market_value == Decimal("11000.00")
    assert account.total_value == Decimal("111000.00")
    assert account.total_trades == 0
    assert account.winning_trades == 0

+++ b/tests/unit/simulated_trading/test_v1_cross_binding_root_red.py
@@ -0,0 +1,39 @@
+"""V1 original-market validator counterexample on unsaved ORM boundary rows."""
+from copy import deepcopy
+import runpy
+import pytest
+from apps.simulated_trading.application.execution_settlement_uow import SimulatedTradeExecutionBlocked
+from apps.simulated_trading.domain.execution_settlement_plan_binding import SimulatedSettlementPlanBindingV1, bind_settlement_execution_plan
+from apps.simulated_trading.infrastructure.execution_settlement_uow_repository import DjangoSimulatedTradeExecutionRepository
+from apps.simulated_trading.infrastructure.models import SimulatedAccountModel, SimulatedTradeModel
+
+def test_resealed_v1_calendar_exchange_still_must_match_original_row_market():
+    fixture = runpy.run_path('tests/unit/simulated_trading/test_execution_settlement_plan_binding.py')
+    plan = fixture['_execution_plan']()
+    original = bind_settlement_execution_plan(plan, executed_at=plan.pre_read_at)
+    payload = deepcopy(original.to_payload())
+    payload['calendar_snapshot']['exchange'] = 'SZSE'
+    modified = SimulatedSettlementPlanBindingV1.from_payload(payload)
+    assert modified.calendar_snapshot.exchange != plan.intent.market
+    snap, pub = original.calendar_snapshot, original.calendar_publication
+    account = SimulatedAccountModel(pk=plan.intent.account_id, user_id=plan.intent.user_id)
+    row = SimulatedTradeModel(
+        account=account, status='executed', asset_code=plan.intent.asset_code,
+        idempotency_key=plan.intent.idempotency_key, request_payload_hash=plan.intent.request_payload_hash,
+        execution_time=original.executed_at, order_date=original.market_session, execution_date=original.market_session,
+        settlement_market=plan.intent.market, settlement_exchange=None,
+        settlement_market_session=original.market_session, settlement_lag_sessions=original.settlement_lag_sessions,
+        settlement_release_date=original.settlement_release_date,
+        settlement_bundle_id=original.settlement_bundle_id, settlement_bundle_version=original.settlement_bundle_version,
+        settlement_bundle_hash=original.settlement_bundle_hash, settlement_policy_id=original.settlement_policy_id,
+        settlement_policy_version=original.settlement_policy_version, settlement_policy_hash=original.settlement_policy_hash,
+        execution_rule_v2_hash=original.execution_rule_v2_hash, settlement_calendar_evidence_hash=original.calendar_evidence_hash,
+        settlement_calendar_snapshot_id=snap.snapshot_id, settlement_calendar_content_hash=snap.content_hash,
+        settlement_calendar_record_digest=snap.record_digest, settlement_calendar_publication_id=pub.publication_id,
+        settlement_calendar_publication_hash=pub.publication_hash, settlement_calendar_policy_hash=pub.policy_hash,
+        settlement_calendar_timezone=pub.timezone_name, fee_schedule_hash=original.fee_policy_content_hash,
+        settlement_plan_binding_version=1, settlement_plan_binding_payload=modified.to_payload(), settlement_plan_binding_hash=modified.content_hash)
+    assert row.settlement_market == plan.intent.market
+    with pytest.raises(SimulatedTradeExecutionBlocked):
+        DjangoSimulatedTradeExecutionRepository(using='default')._validate_plan_binding(
+            row=row, intent=plan.intent, fee_policy_v2=plan.fee_policy_v2)

diff --git a/.tmp/test_auto_outcome_repository_fallback.py b/.tmp/test_auto_outcome_repository_fallback.py
new file mode 100644
index 0000000000000000000000000000000000000000..1ab5131eed5f75abd16453d2c2558211b8403d3e
--- /dev/null
+++ b/.tmp/test_auto_outcome_repository_fallback.py
@@ -0,0 +1,33 @@
+from datetime import UTC, date, datetime
+from types import SimpleNamespace
+from unittest.mock import Mock, patch
+from apps.risk_center.application.trade_guard import PreTradeRiskCheckResult
+from apps.simulated_trading.application.auto_trading_engine import AutoTradingEngine
+from apps.simulated_trading.application.facade import SimulatedTradingFacade
+from apps.strategy.application.execution_gateway import StrategyExecutionGateway
+from apps.simulated_trading.domain.entities import AccountType, OrderStatus, SimulatedAccount, SimulatedTrade, TradeAction
+
+def test_failed_strategy_binding_must_never_execute_a_legacy_buy():
+    account = SimulatedAccount(account_id=17, account_name="synthetic-fallback", account_type=AccountType.SIMULATED,
+        initial_capital=100000.0, current_cash=100000.0, current_market_value=0.0, total_value=100000.0)
+    account_repo = Mock(get_active_accounts=Mock(return_value=[account]))
+    positions = Mock(get_by_account=Mock(return_value=[]), get_position=Mock(return_value=None))
+    receipt = SimulatedTrade(trade_id=47, account_id=17, asset_code="000001.SZ", asset_name="synthetic",
+        asset_type="equity", action=TradeAction.BUY, quantity=100.0, price=10.0, amount=1000.0,
+        order_date=date(2026,10,16), execution_date=date(2026,10,16), execution_time=datetime(2026,10,16,2,tzinfo=UTC),
+        status=OrderStatus.EXECUTED)
+    buy = Mock(execute=Mock(return_value=receipt))
+    pool = Mock(get_investable_assets_with_signals=Mock(return_value=[{"asset_code":"000001.SZ", "asset_name":"synthetic", "asset_type":"equity", "score":90.0}]))
+    price = SimpleNamespace(get_price=lambda code, day: 10.0, require_price=lambda code, day: 10.0)
+    engine = AutoTradingEngine(account_repo=account_repo, position_repo=positions, trade_repo=Mock(),
+        buy_use_case=buy, sell_use_case=Mock(), performance_use_case=Mock(), asset_pool_service=pool,
+        price_provider=price, pre_trade_risk_guard=Mock(execute=Mock(return_value=PreTradeRiskCheckResult(passed=True))))
+    engine._update_account_performance = Mock(return_value=True)
+    query = Mock()
+    query.get_active_strategy_binding.side_effect = RuntimeError("synthetic repository read failure")
+    gateway = StrategyExecutionGateway(query_repository=query)
+    facade = SimulatedTradingFacade(account_repo=account_repo, position_repo=positions)
+    with patch("apps.simulated_trading.application.facade.get_simulated_trading_facade", return_value=facade), patch("apps.strategy.application.execution_gateway.get_strategy_execution_gateway", return_value=gateway):
+        engine.run_daily_trading(date(2026,10,16))
+    query.get_active_strategy_binding.assert_called_once_with(17)
+    buy.execute.assert_not_called()

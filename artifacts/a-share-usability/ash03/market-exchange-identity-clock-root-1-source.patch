diff --git a/tests/unit/simulated_trading/test_identity_source_clock_root_red.py b/tests/unit/simulated_trading/test_identity_source_clock_root_red.py
new file mode 100644
index 0000000000000000000000000000000000000000..1e02d62d4a2fa85db0af548493011d8ca8f3dfba
--- /dev/null
+++ b/tests/unit/simulated_trading/test_identity_source_clock_root_red.py
@@ -0,0 +1,20 @@
+"""Synthetic identity chronology counterexample; no actual source qualification."""
+from datetime import UTC, datetime, timedelta
+from uuid import UUID
+import pytest
+from apps.simulated_trading.domain.execution_settlement_identity import ExecutionInstrumentIdentityEvidenceV1, IdentityEvidenceValidationError
+
+def test_identity_cannot_be_available_after_the_response_that_already_contained_it():
+    t = datetime(2026, 10, 16, 2, tzinfo=UTC)
+    evidence = ExecutionInstrumentIdentityEvidenceV1(
+        security_id='INTERNAL.SECURITY', asset_code='local-security', source_code='source-security',
+        source_exchange='SRC_EXCHANGE', source_market='source-main', rule_market='RULE_MKT', board='MAIN',
+        snapshot_id=UUID('11111111-1111-4111-8111-111111111111'), snapshot_content_hash='sha256:'+'1'*64,
+        snapshot_record_digest='sha256:'+'2'*64, first_seen_at=t-timedelta(minutes=10), snapshot_recorded_at=t-timedelta(minutes=8),
+        mapping_record_id=UUID('22222222-2222-4222-8222-222222222222'), mapping_id='explicit-mapping', mapping_version='1',
+        mapping_content_hash='sha256:'+'3'*64, mapping_record_digest='sha256:'+'4'*64, mapping_recorded_at=t-timedelta(minutes=12),
+        response_completed_at=t-timedelta(minutes=10), source_observed_at=t-timedelta(minutes=20),
+        source_available_at=t-timedelta(minutes=1), identity_valid_from=t-timedelta(days=1), identity_valid_until=t+timedelta(days=1),
+        must_not_use_for_decision=False, must_not_execute=False)
+    with pytest.raises(IdentityEvidenceValidationError):
+        evidence.validate_at(as_of=t)

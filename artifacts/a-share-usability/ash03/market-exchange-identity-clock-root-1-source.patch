diff --git a/apps/simulated_trading/domain/execution_settlement_identity.py b/apps/simulated_trading/domain/execution_settlement_identity.py
new file mode 100644
index 0000000000000000000000000000000000000000..5d20f69c450954d7d515816cf246c8eda9c880ca
--- /dev/null
+++ b/apps/simulated_trading/domain/execution_settlement_identity.py
@@ -0,0 +1,460 @@
+"""Exact market-to-source identity evidence for candidate settlement V2 plans.
+
+The instrument-reference source currently marks its snapshots as non-decision
+and non-execution evidence and has unknown upstream clocks. This contract
+preserves those facts and fails closed; it does not create a production owner,
+grant authority, or qualify the source for settlement execution.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+from dataclasses import dataclass
+from datetime import UTC, date, datetime
+from typing import cast
+from uuid import UUID
+
+from .execution_settlement_uow import (
+    SettlementExecutionPlan,
+    SimulatedSettlementContractError,
+    SimulatedTradeIntent,
+)
+
+_IDENTITY_SCHEMA = "simulated-execution-instrument-identity.v1"
+_PENDING_SCOPE_SCHEMA = "simulated-pending-settlement-scope.v1"
+_TOKEN_MAX_LENGTH = 192
+_SHA256_PATTERN = re.compile(r"^sha256:[0-9a-f]{64}$")
+
+
+class IdentityEvidenceValidationError(SimulatedSettlementContractError):
+    """Raised when identity evidence is malformed or not qualified at a cutoff."""
+
+    def __init__(self, code: str) -> None:
+        """Create an identity error with a stable machine-readable code."""
+
+        self.code = code
+        super().__init__(code)
+
+
+def _require_token(value: object, name: str) -> str:
+    """Require a bounded, exact token without guessing or normalizing it."""
+
+    if (
+        type(value) is not str
+        or not value
+        or len(value) > _TOKEN_MAX_LENGTH
+        or value.strip() != value
+        or any(character.isspace() for character in value)
+    ):
+        raise IdentityEvidenceValidationError("IDENTITY_EVIDENCE_TOKEN_INVALID")
+    return value
+
+
+def _normalize_utc(value: object, name: str) -> datetime:
+    """Validate an aware instant and normalize it to UTC without inventing time."""
+
+    if type(value) is not datetime or value.tzinfo is None:
+        raise IdentityEvidenceValidationError("IDENTITY_EVIDENCE_TIME_INVALID")
+    try:
+        if value.utcoffset() is None:
+            raise IdentityEvidenceValidationError("IDENTITY_EVIDENCE_TIME_INVALID")
+        return value.astimezone(UTC)
+    except (OverflowError, TypeError, ValueError) as error:
+        raise IdentityEvidenceValidationError("IDENTITY_EVIDENCE_TIME_INVALID") from error
+
+
+def _utc_text(value: datetime) -> str:
+    """Serialize one normalized instant with canonical `Z` notation."""
+
+    return _normalize_utc(value, "datetime").isoformat().replace("+00:00", "Z")
+
+
+def _parse_utc(value: object) -> datetime:
+    """Parse only canonical UTC text emitted by this contract."""
+
+    if type(value) is not str or not value.endswith("Z"):
+        raise IdentityEvidenceValidationError("IDENTITY_EVIDENCE_TIME_INVALID")
+    try:
+        parsed = datetime.fromisoformat(f"{value[:-1]}+00:00")
+    except ValueError as error:
+        raise IdentityEvidenceValidationError("IDENTITY_EVIDENCE_TIME_INVALID") from error
+    normalized = _normalize_utc(parsed, "datetime")
+    if _utc_text(normalized) != value:
+        raise IdentityEvidenceValidationError("IDENTITY_EVIDENCE_TIME_NOT_CANONICAL")
+    return normalized
+
+
+def _parse_uuid(value: object) -> UUID:
+    """Parse one lowercase hyphenated canonical UUID string."""
+
+    if type(value) is not str:
+        raise IdentityEvidenceValidationError("IDENTITY_EVIDENCE_UUID_INVALID")
+    try:
+        parsed = UUID(value)
+    except (AttributeError, TypeError, ValueError) as error:
+        raise IdentityEvidenceValidationError("IDENTITY_EVIDENCE_UUID_INVALID") from error
+    if str(parsed) != value:
+        raise IdentityEvidenceValidationError("IDENTITY_EVIDENCE_UUID_NOT_CANONICAL")
+    return parsed
+
+
+def _require_prefixed_hash(value: object) -> str:
+    """Require a source-row digest in the data-center's prefixed SHA format."""
+
+    if type(value) is not str or _SHA256_PATTERN.fullmatch(value) is None:
+        raise IdentityEvidenceValidationError("IDENTITY_EVIDENCE_HASH_INVALID")
+    return value
+
+
+def _object(value: object, expected_keys: frozenset[str]) -> dict[str, object]:
+    """Require a JSON object with exactly the contract's fields."""
+
+    if type(value) is not dict or set(value) != expected_keys:
+        raise IdentityEvidenceValidationError("IDENTITY_EVIDENCE_PAYLOAD_INVALID")
+    return cast(dict[str, object], value)
+
+
+@dataclass(frozen=True, slots=True)
+class ExecutionInstrumentIdentityEvidenceV1:
+    """Bind one internal security to exact source and Rule market identities.
+
+    `security_id` and `source_code` are an explicit pair returned by an
+    injected identity reader; `asset_code` is retained separately and is not
+    assumed to equal the provider's code. The local response-completion and
+    repository knowledge clocks are distinct from upstream observation and
+    availability clocks. Unknown source clocks and restrictive source flags
+    remain representable so stored/reference evidence is not rewritten; the
+    plan validator blocks it for a new simulated settlement execution.
+
+    `identity_valid_from` and `identity_valid_until` must be supplied by a
+    separately qualified reader. This value object never derives them from
+    first-seen time or a default TTL. It is an integrity/identity assertion,
+    not authorization or production source qualification.
+    """
+
+    security_id: str
+    asset_code: str
+    source_code: str
+    source_exchange: str
+    source_market: str | None
+    rule_market: str
+    board: str
+    snapshot_id: UUID
+    snapshot_content_hash: str
+    snapshot_record_digest: str
+    first_seen_at: datetime
+    snapshot_recorded_at: datetime
+    mapping_record_id: UUID
+    mapping_id: str
+    mapping_version: str
+    mapping_content_hash: str
+    mapping_record_digest: str
+    mapping_recorded_at: datetime
+    response_completed_at: datetime
+    source_observed_at: datetime | None
+    source_available_at: datetime | None
+    identity_valid_from: datetime
+    identity_valid_until: datetime
+    must_not_use_for_decision: bool
+    must_not_execute: bool
+
+    def __post_init__(self) -> None:
+        """Validate exact identity fields, seals and independent clocks."""
+
+        for name in (
+            "security_id",
+            "asset_code",
+            "source_code",
+            "source_exchange",
+            "rule_market",
+            "board",
+            "mapping_id",
+            "mapping_version",
+        ):
+            _require_token(getattr(self, name), name)
+        if self.source_market is not None:
+            _require_token(self.source_market, "source_market")
+        for name in ("snapshot_id", "mapping_record_id"):
+            if type(getattr(self, name)) is not UUID:
+                raise IdentityEvidenceValidationError("IDENTITY_EVIDENCE_UUID_INVALID")
+        for name in (
+            "snapshot_content_hash",
+            "snapshot_record_digest",
+            "mapping_content_hash",
+            "mapping_record_digest",
+        ):
+            _require_prefixed_hash(getattr(self, name))
+        for name in (
+            "first_seen_at",
+            "snapshot_recorded_at",
+            "mapping_recorded_at",
+            "response_completed_at",
+            "identity_valid_from",
+            "identity_valid_until",
+        ):
+            object.__setattr__(self, name, _normalize_utc(getattr(self, name), name))
+        for name in ("source_observed_at", "source_available_at"):
+            value = getattr(self, name)
+            if value is not None:
+                object.__setattr__(self, name, _normalize_utc(value, name))
+        if type(self.must_not_use_for_decision) is not bool or type(self.must_not_execute) is not bool:
+            raise IdentityEvidenceValidationError("IDENTITY_EVIDENCE_FLAG_INVALID")
+        if self.first_seen_at != self.response_completed_at:
+            raise IdentityEvidenceValidationError("IDENTITY_RESPONSE_CLOCK_MISMATCH")
+        if self.mapping_recorded_at > self.snapshot_recorded_at:
+            raise IdentityEvidenceValidationError("IDENTITY_KNOWLEDGE_CLOCK_ORDER_INVALID")
+        if self.snapshot_recorded_at < self.first_seen_at:
+            raise IdentityEvidenceValidationError("IDENTITY_KNOWLEDGE_CLOCK_ORDER_INVALID")
+        if self.identity_valid_from >= self.identity_valid_until:
+            raise IdentityEvidenceValidationError("IDENTITY_VALIDITY_WINDOW_INVALID")
+
+    def to_payload(self) -> dict[str, object]:
+        """Return a fresh strict wire payload without embedding its checksum."""
+
+        self.__post_init__()
+        return {
+            "schema": _IDENTITY_SCHEMA,
+            "security_id": self.security_id,
+            "asset_code": self.asset_code,
+            "source_code": self.source_code,
+            "source_exchange": self.source_exchange,
+            "source_market": self.source_market,
+            "rule_market": self.rule_market,
+            "board": self.board,
+            "snapshot_id": str(self.snapshot_id),
+            "snapshot_content_hash": self.snapshot_content_hash,
+            "snapshot_record_digest": self.snapshot_record_digest,
+            "first_seen_at": _utc_text(self.first_seen_at),
+            "snapshot_recorded_at": _utc_text(self.snapshot_recorded_at),
+            "mapping_record_id": str(self.mapping_record_id),
+            "mapping_id": self.mapping_id,
+            "mapping_version": self.mapping_version,
+            "mapping_content_hash": self.mapping_content_hash,
+            "mapping_record_digest": self.mapping_record_digest,
+            "mapping_recorded_at": _utc_text(self.mapping_recorded_at),
+            "response_completed_at": _utc_text(self.response_completed_at),
+            "source_observed_at": (
+                _utc_text(self.source_observed_at)
+                if self.source_observed_at is not None
+                else None
+            ),
+            "source_available_at": (
+                _utc_text(self.source_available_at)
+                if self.source_available_at is not None
+                else None
+            ),
+            "identity_valid_from": _utc_text(self.identity_valid_from),
+            "identity_valid_until": _utc_text(self.identity_valid_until),
+            "must_not_use_for_decision": self.must_not_use_for_decision,
+            "must_not_execute": self.must_not_execute,
+        }
+
+    @classmethod
+    def from_payload(cls, payload: object) -> ExecutionInstrumentIdentityEvidenceV1:
+        """Strictly decode the exact v1 identity receipt without defaulting fields."""
+
+        expected = frozenset(
+            {
+                "schema",
+                "security_id",
+                "asset_code",
+                "source_code",
+                "source_exchange",
+                "source_market",
+                "rule_market",
+                "board",
+                "snapshot_id",
+                "snapshot_content_hash",
+                "snapshot_record_digest",
+                "first_seen_at",
+                "snapshot_recorded_at",
+                "mapping_record_id",
+                "mapping_id",
+                "mapping_version",
+                "mapping_content_hash",
+                "mapping_record_digest",
+                "mapping_recorded_at",
+                "response_completed_at",
+                "source_observed_at",
+                "source_available_at",
+                "identity_valid_from",
+                "identity_valid_until",
+                "must_not_use_for_decision",
+                "must_not_execute",
+            }
+        )
+        fields = _object(payload, expected)
+        if type(fields["schema"]) is not str or fields["schema"] != _IDENTITY_SCHEMA:
+            raise IdentityEvidenceValidationError("IDENTITY_EVIDENCE_SCHEMA_UNSUPPORTED")
+        for name in (
+            "security_id",
+            "asset_code",
+            "source_code",
+            "source_exchange",
+            "rule_market",
+            "board",
+            "snapshot_content_hash",
+            "snapshot_record_digest",
+            "mapping_content_hash",
+            "mapping_record_digest",
+            "mapping_id",
+            "mapping_version",
+        ):
+            if type(fields[name]) is not str:
+                raise IdentityEvidenceValidationError("IDENTITY_EVIDENCE_PAYLOAD_INVALID")
+        source_market = fields["source_market"]
+        if source_market is not None and type(source_market) is not str:
+            raise IdentityEvidenceValidationError("IDENTITY_EVIDENCE_PAYLOAD_INVALID")
+        for name in ("must_not_use_for_decision", "must_not_execute"):
+            if type(fields[name]) is not bool:
+                raise IdentityEvidenceValidationError("IDENTITY_EVIDENCE_FLAG_INVALID")
+        observed = fields["source_observed_at"]
+        available = fields["source_available_at"]
+        if observed is not None and type(observed) is not str:
+            raise IdentityEvidenceValidationError("IDENTITY_EVIDENCE_PAYLOAD_INVALID")
+        if available is not None and type(available) is not str:
+            raise IdentityEvidenceValidationError("IDENTITY_EVIDENCE_PAYLOAD_INVALID")
+        return cls(
+            security_id=cast(str, fields["security_id"]),
+            asset_code=cast(str, fields["asset_code"]),
+            source_code=cast(str, fields["source_code"]),
+            source_exchange=cast(str, fields["source_exchange"]),
+            source_market=cast(str | None, source_market),
+            rule_market=cast(str, fields["rule_market"]),
+            board=cast(str, fields["board"]),
+            snapshot_id=_parse_uuid(fields["snapshot_id"]),
+            snapshot_content_hash=cast(str, fields["snapshot_content_hash"]),
+            snapshot_record_digest=cast(str, fields["snapshot_record_digest"]),
+            first_seen_at=_parse_utc(fields["first_seen_at"]),
+            snapshot_recorded_at=_parse_utc(fields["snapshot_recorded_at"]),
+            mapping_record_id=_parse_uuid(fields["mapping_record_id"]),
+            mapping_id=cast(str, fields["mapping_id"]),
+            mapping_version=cast(str, fields["mapping_version"]),
+            mapping_content_hash=cast(str, fields["mapping_content_hash"]),
+            mapping_record_digest=cast(str, fields["mapping_record_digest"]),
+            mapping_recorded_at=_parse_utc(fields["mapping_recorded_at"]),
+            response_completed_at=_parse_utc(fields["response_completed_at"]),
+            source_observed_at=_parse_utc(observed) if observed is not None else None,
+            source_available_at=_parse_utc(available) if available is not None else None,
+            identity_valid_from=_parse_utc(fields["identity_valid_from"]),
+            identity_valid_until=_parse_utc(fields["identity_valid_until"]),
+            must_not_use_for_decision=cast(bool, fields["must_not_use_for_decision"]),
+            must_not_execute=cast(bool, fields["must_not_execute"]),
+        )
+
+    def validate_at(self, *, as_of: datetime) -> None:
+        """Require affirmative, known source evidence at one exact decision cutoff."""
+
+        self.__post_init__()
+        cutoff = _normalize_utc(as_of, "as_of")
+        if self.must_not_use_for_decision or self.must_not_execute:
+            raise IdentityEvidenceValidationError("IDENTITY_SOURCE_RESTRICTED")
+        if self.source_market is None:
+            raise IdentityEvidenceValidationError("IDENTITY_SOURCE_MARKET_UNKNOWN")
+        if self.source_observed_at is None or self.source_available_at is None:
+            raise IdentityEvidenceValidationError("IDENTITY_SOURCE_CLOCK_UNKNOWN")
+        if self.source_observed_at > self.source_available_at:
+            raise IdentityEvidenceValidationError("IDENTITY_SOURCE_CLOCK_ORDER_INVALID")
+        knowledge_times = (
+            self.response_completed_at,
+            self.first_seen_at,
+            self.snapshot_recorded_at,
+            self.mapping_recorded_at,
+            self.source_observed_at,
+            self.source_available_at,
+        )
+        if any(knowledge_time > cutoff for knowledge_time in knowledge_times):
+            raise IdentityEvidenceValidationError("IDENTITY_EVIDENCE_NOT_KNOWN_AT_CUTOFF")
+        if not self.identity_valid_from <= cutoff < self.identity_valid_until:
+            raise IdentityEvidenceValidationError("IDENTITY_EVIDENCE_OUTSIDE_VALIDITY_WINDOW")
+
+    def validate_for(self, *, intent: SimulatedTradeIntent, as_of: datetime) -> None:
+        """Bind the evidence to exact intent identity and a valid time window."""
+
+        if type(intent) is not SimulatedTradeIntent:
+            raise IdentityEvidenceValidationError("IDENTITY_INTENT_INVALID")
+        try:
+            SimulatedTradeIntent.__post_init__(intent)
+        except (AttributeError, ArithmeticError, TypeError, ValueError) as error:
+            raise IdentityEvidenceValidationError("IDENTITY_INTENT_INVALID") from error
+        self.validate_at(as_of=as_of)
+        if self.security_id != intent.security_id or self.asset_code != intent.asset_code:
+            raise IdentityEvidenceValidationError("IDENTITY_INTENT_MISMATCH")
+        if self.rule_market != intent.market:
+            raise IdentityEvidenceValidationError("IDENTITY_RULE_MARKET_MISMATCH")
+        if self.board != intent.board:
+            raise IdentityEvidenceValidationError("IDENTITY_BOARD_MISMATCH")
+
+
+@dataclass(frozen=True, slots=True)
+class SettlementExecutionPlanV2(SettlementExecutionPlan):
+    """Settlement plan with an explicit source-exchange identity receipt.
+
+    The order's `intent.market` remains the Risk and fee market. Only the
+    exchange-calendar identity comes from the validated source-exchange
+    mapping. Current source snapshots remain blocked while they carry source
+    restrictions or unknown source clocks.
+    """
+
+    identity_evidence: ExecutionInstrumentIdentityEvidenceV1
+
+    @property
+    def _expected_calendar_exchange(self) -> str:
+        """Return the exchange bound by this V2 plan's explicit identity receipt."""
+
+        return self.identity_evidence.source_exchange
+
+    def __post_init__(self) -> None:
+        """Validate the shared plan plus explicit identity and market mapping."""
+
+        if type(self.identity_evidence) is not ExecutionInstrumentIdentityEvidenceV1:
+            raise IdentityEvidenceValidationError("IDENTITY_EVIDENCE_TYPE_INVALID")
+        try:
+            ExecutionInstrumentIdentityEvidenceV1.__post_init__(self.identity_evidence)
+        except IdentityEvidenceValidationError:
+            raise
+        except (AttributeError, ArithmeticError, TypeError, ValueError) as error:
+            raise IdentityEvidenceValidationError("IDENTITY_EVIDENCE_INVALID") from error
+        super().__post_init__()
+        self.identity_evidence.validate_for(intent=self.intent, as_of=self.pre_read_at)
+
+    def validate_at(self, as_of: datetime) -> None:
+        """Revalidate shared execution evidence and identity at the locked cutoff."""
+
+        super().validate_at(as_of)
+        self.identity_evidence.validate_for(intent=self.intent, as_of=as_of)
+
+
+@dataclass(frozen=True, slots=True)
+class PendingSettlementScopeV1:
+    """Exact bounded start scope for pending rows in one source exchange."""
+
+    earliest_session: date
+    source_exchange: str
+
+    def __post_init__(self) -> None:
+        """Require an exact session date and explicit exchange token."""
+
+        if type(self.earliest_session) is not date:
+            raise IdentityEvidenceValidationError("PENDING_SETTLEMENT_SCOPE_INVALID")
+        _require_token(self.source_exchange, "source_exchange")
+
+    def to_payload(self) -> dict[str, object]:
+        """Return a fresh canonical scope payload for the repository boundary."""
+
+        self.__post_init__()
+        return {
+            "schema": _PENDING_SCOPE_SCHEMA,
+            "earliest_session": self.earliest_session.isoformat(),
+            "source_exchange": self.source_exchange,
+        }
+
+
+__all__: tuple[str, ...] = (
+    "ExecutionInstrumentIdentityEvidenceV1",
+    "IdentityEvidenceValidationError",
+    "PendingSettlementScopeV1",
+    "SettlementExecutionPlanV2",
+)

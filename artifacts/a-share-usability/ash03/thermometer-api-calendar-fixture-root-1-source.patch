+@pytest.mark.django_db
+def test_market_thermometer_current_fails_closed_without_calendar(
+    user_client: Client,
+    install_synthetic_market_calendar: Callable[[date | None], None],
+) -> None:
+    """Return the stable unavailable contract when the calendar boundary has no session."""
+
+    install_synthetic_market_calendar(None)
+
+    response = user_client.get("/api/data-center/market-thermometer/current/")
+
+    assert response.status_code == 503
+    assert response["Content-Type"].startswith("application/json")
+    payload = response.json()
+    assert type(payload) is dict
+    assert type(payload["code"]) is str
+    assert payload["code"] == "MARKET_CALENDAR_UNAVAILABLE"
+    assert "score" not in payload
+    assert "success" not in payload
+

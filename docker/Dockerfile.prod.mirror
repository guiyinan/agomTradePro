FROM docker.1ms.run/library/python:3.11-slim AS builder

WORKDIR /app
ARG INSTALL_QLIB=1
ARG PYQLIB_VERSION=0.9.7

COPY requirements-prod.txt /tmp/requirements-prod.txt
COPY .cache/pip-wheels/linux-py311 /tmp/pip-wheels/linux-py311

RUN set -eu; \
    pip_try() { \
      idx="$1"; \
      echo "Installing from: $idx"; \
      PIP_INDEX_URL="$idx" pip install --prefer-binary --retries 25 --timeout 180 -r /tmp/requirements-prod.txt; \
    }; \
    ALIYUN_URL="https://mirrors.aliyun.com/pypi/simple/"; \
    PYPI_URL="https://pypi.org/simple/"; \
    TUNA_URL="https://pypi.tuna.tsinghua.edu.cn/simple/"; \
    if [ -d "/tmp/pip-wheels/linux-py311" ] && [ "$(ls -A /tmp/pip-wheels/linux-py311 2>/dev/null)" ]; then \
      echo "Installing from local Linux wheelhouse first"; \
      pip install --no-index --find-links=/tmp/pip-wheels/linux-py311 -r /tmp/requirements-prod.txt || \
      (pip_try "$PYPI_URL" || pip_try "$ALIYUN_URL" || pip_try "$TUNA_URL" || pip_try "$PYPI_URL"); \
    else \
      echo "No local Linux wheelhouse found, using online indexes"; \
      (pip_try "$PYPI_URL" || pip_try "$ALIYUN_URL" || pip_try "$TUNA_URL" || pip_try "$PYPI_URL"); \
    fi

RUN if [ "$INSTALL_QLIB" = "1" ]; then \
      echo "Installing Microsoft pyqlib (imports as qlib; requires Linux wheels)..."; \
      pip install --prefer-binary --retries 25 --timeout 300 \
        --index-url https://pypi.org/simple/ \
        "pyqlib==${PYQLIB_VERSION}" || \
      pip install --prefer-binary --retries 25 --timeout 300 \
        --index-url https://mirrors.aliyun.com/pypi/simple/ \
        "pyqlib==${PYQLIB_VERSION}" || \
      pip install --prefer-binary --retries 25 --timeout 300 \
        --index-url https://pypi.tuna.tsinghua.edu.cn/simple/ \
        "pyqlib==${PYQLIB_VERSION}"; \
      python -c "import importlib.metadata as metadata; import qlib; import qlib.data; dist = metadata.distribution('pyqlib'); print(f'Verified pyqlib {dist.version} at {qlib.__file__}')" ; \
    fi

FROM docker.1ms.run/library/python:3.11-slim

WORKDIR /app
ARG DEBIAN_FRONTEND=noninteractive
ARG POSTGRESQL_CLIENT_MAJOR=16
ARG BUILD_AGOMTRADEPRO_ENCRYPTION_KEY=QkZJTFQwMTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM0NTY3OD0=
ARG SOURCE_COMMIT=unknown

LABEL org.opencontainers.image.revision=$SOURCE_COMMIT

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl; \
    install -d /usr/share/postgresql-common/pgdg; \
    curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
      -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc; \
    . /etc/os-release; \
    echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt ${VERSION_CODENAME}-pgdg main" \
      > /etc/apt/sources.list.d/pgdg.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      libpq5 \
      "postgresql-client-${POSTGRESQL_CLIENT_MAJOR}" \
      libgomp1 \
      procps; \
    pg_dump --version | grep -E "^pg_dump \(PostgreSQL\) ${POSTGRESQL_CLIENT_MAJOR}\."; \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local /usr/local

COPY . /app
COPY docker/entrypoint.prod.sh /entrypoint.sh

RUN SOURCE_COMMIT="$SOURCE_COMMIT" python -c "import json, os; from pathlib import Path; from core.version import get_version; payload = {'schema_version': 1, 'app_version': get_version(), 'source_commit': os.environ['SOURCE_COMMIT']}; Path('/app/.agom-build-identity.json').write_text(json.dumps(payload, sort_keys=True) + '\\n', encoding='utf-8')"

RUN chmod +x /entrypoint.sh && \
    mkdir -p /app/staticfiles /app/media /app/var && \
    AGOMTRADEPRO_ENCRYPTION_KEY=$BUILD_AGOMTRADEPRO_ENCRYPTION_KEY python manage.py collectstatic --noinput --clear

RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=5 \
    CMD curl -fsS http://127.0.0.1:8000/api/health/ || exit 1

ENTRYPOINT ["/entrypoint.sh"]
CMD ["daphne"]
